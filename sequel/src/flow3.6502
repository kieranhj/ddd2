\ flow3.6502 - flow.6502's tables, part 2, assembled for page 3 at &03C0 (main.6502's page3
\ section, after the mirrored enemies; decision 46).

.bit_of     EQUB 1, 2, 4, 8
\ print's (flow.6502) two pixels a byte, white: neither, the right, the left, both (MODE 2)
.pr_white   EQUB &00, &15, &2A, &3F
\ the legend's keys (flow8.6502's lg_key)
.t_k2       EQUB G_SKIP + 4, G_G, G_SKIP + 4, G_H, G_SKIP + 5, G_J, &FF
.t_k3       EQUB G_SKIP + 4, G_COMMA, G_SKIP + 4, G_DOT, G_SKIP + 5, G_SLASH, &FF
.t_k4b      EQUB G_SKIP + 3, G_L, G_E, G_F, G_T, G_SPACE, G_D, G_O, G_W, G_N, G_SPACE   \ no keypad:
            EQUB G_R, G_I, G_G, G_H, G_T, &FF                                       \ the cursor keys
