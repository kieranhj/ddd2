\ flow1.6502 - flow.6502's game end and its texts, assembled for the stack page below &01C0
\ (the stack never went below &01D8, tools/memwatch.mjs; decision 32): copied there by start.

\ game_done: after a pass. Every player out of takes or finished: the game's end.
.game_done
    LDX #3
.gd_strip
    LDA phase,X
    CMP #PHASE_IDLE
    BEQ gd_next
    CMP #3                      \ out of takes
    BEQ gd_next
    LDA finished,X
    BNE gd_next
    RTS                         \ someone is still riding
.gd_next
    DEX
    BPL gd_strip
    \ the end: the winner, the most wages (the first of equals)
    LDA #&FF
    STA winner
    LDX #0
.gd_best
    LDA phase,X
    CMP #PHASE_IDLE
    BEQ gd_bnext
    LDY winner
    BMI gd_take                 \ the first player
    STX tmp                     \ more than the best so far? compare digit by digit
    LDA strip6,X
    STA tmp2
    LDA strip6,Y
    TAY
    LDX tmp2
    LDA #6
    STA en_cnt
.gd_cmp
    LDA wages,X
    CMP wages,Y
    BNE gd_differ
    INX
    INY
    DEC en_cnt
    BNE gd_cmp
    LDX tmp                     \ equal: the first stays
    JMP gd_bnext
.gd_differ
    LDX tmp
    BCC gd_bnext                \ less
.gd_take
    STX winner
.gd_bnext
    INX
    CPX #4
    BNE gd_best
    LDA winner                  \ (glyph 0-3 is the digit 1-4)
    STA t_winner_n
    LDX #T_WINS
    JSR print
    LDA #250
    STA tmp2
.gd_wait
    JSR next_field
    DEC tmp2
    BNE gd_wait
    PLA                         \ (game_done was called from the loop: it does not return)
    PLA
    JMP title

.texts
.t_title
    EQUW TEXT_ROW + 1 * 32
    EQUB G_P, G_R, G_E, G_S, G_S, G_SPACE, G_A, G_DASH, G_F, G_SPACE    \ PRESS A-F TO START
    EQUB G_T, G_O, G_SPACE, G_S, G_T, G_A, G_R, G_T, &FF
.t_wins
    EQUW TEXT_ROW + 3 * 32
    EQUB G_P, G_L, G_A, G_Y, G_E, G_R, G_SPACE                          \ PLAYER n WINS
.t_winner_n
    EQUB G_1, G_SPACE, G_W, G_I, G_N, G_S, &FF

\ mark_phase: X = strip, at a new pos. Its first marker's screen column (marks.6502): with the
\ markers at course columns 20k + 19, mph = 19 - pos MOD 20. pos MOD 20 = (pos_hi MOD 5) x 16 +
\ pos_lo, MOD 20 (256 = 16 and 5 x 16 = 80 = 0, MOD 20). X kept.
.mark_phase
    LDA pos_hi,X
.mp_5
    CMP #5
    BCC mp_16
    SBC #5
    BCS mp_5                    \ (always)
.mp_16
    ASL A : ASL A : ASL A : ASL A   \ (<= 64: C clear)
    ADC pos_lo,X
    BCC mp_20
    SBC #160                    \ (C set: 256 + A - 160, 8 x 20)
.mp_20
    CMP #MARK_GAP
    BCC mp_m
    SBC #MARK_GAP
    BCS mp_20                   \ (always)
.mp_m
    EOR #&FF                    \ 19 - it (C clear: 255 - it + 20)
    ADC #MARK_GAP
    STA mph,X
    RTS

