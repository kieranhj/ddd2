\ flow1.6502 - flow.6502's game end and its texts, assembled for the stack page below &01D0
\ (the stack never went below &01D8, tools/memwatch.mjs; decision 32): copied there by start.

\ (game_done: flow0.6502, rows 0-2)

\ respawn (main.6502's): X = strip, phase 2: placed, its ground drawn (cu_erase). The rest of it
\ drawn (draw_objects: the next field draws its rider again, and collide looks under it).
.respawn
    LDA #0
    STA phase,X
    JSR set_bases
    JMP draw_objects
\ slot_g (enemies.6502's): eg = slot `es` x PER_SLOT, its first enemy. Y kept.
.slot_g
    LDX es
    LDA slot_base,X
    STA eg
    RTS

.t_title
    EQUW TEXT_ROW
    EQUB G_P, G_R, G_E, G_S, G_S, G_SPACE, G_S, G_P, G_A, G_C, G_E    \ PRESS SPACE TO START
    EQUB G_SPACE, G_T, G_O, G_SPACE, G_S, G_T, G_A, G_R, G_T, &FF
.t_wins
    EQUW TEXT_ROW + 3 * 32
    EQUB G_P, G_L, G_A, G_Y, G_E, G_R, G_SPACE                          \ PLAYER n WINS
.t_winner_n
    EQUB G_1, G_SPACE, G_W, G_I, G_N, G_S, &FF

\ mark_phase: X = strip, at a new pos. Its first marker's screen column (marks.6502): with the
\ markers at course columns 20k + 19, mph = 19 - pos MOD 20. pos MOD 20 = (pos_hi MOD 5) x 16 +
\ pos_lo, MOD 20 (256 = 16 and 5 x 16 = 80 = 0, MOD 20). X kept.
.mark_phase
    LDA pos_hi,X
.mp_5
    CMP #5
    BCC mp_16
    SBC #5
    BCS mp_5                    \ (always)
.mp_16
    ASL A : ASL A : ASL A : ASL A   \ (<= 64: C clear)
    ADC pos_lo,X
    BCC mp_20
    SBC #160                    \ (C set: 256 + A - 160, 8 x 20)
.mp_20
    CMP #MARK_GAP
    BCC mp_m
    SBC #MARK_GAP
    BCS mp_20                   \ (always)
.mp_m
    EOR #&FF                    \ 19 - it (C clear: 255 - it + 20)
    ADC #MARK_GAP
    STA mph,X
    RTS

