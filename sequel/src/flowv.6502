\ flowv.6502 - the legend's labels and the joining line (flow.6502's legend, decision 52),
\ assembled for &020A-&0235: the MOS's vectors BYTEV to IND3V, which nothing reads or writes once
\ `start` has taken the interrupt (tools/memwatch.mjs: only IRQ1V is read in play) and which
\ BREAK does not need (verify_break.mjs --fill 20a-235:V, Model B and Master). Copied by start.

.t_head     EQUB G_SKIP + 2, G_A, G_C, G_C, G_E, G_L, G_SPACE, G_J, G_U, G_M, G_P   \ ACCEL JUMP BRAKE
            EQUB G_SPACE, G_B, G_R, G_A, G_K, G_E, &FF
.t_join     EQUW SCREEN + 17 * ROW + 1 * 32                                    \ row 17
            EQUB G_A, G_C, G_C, G_E, G_L, G_E, G_R, G_A, G_T, G_E, G_SPACE   \ ACCELERATE TO JOIN
            EQUB G_T, G_O, G_SPACE, G_J, G_O, G_I, G_N, &FF
