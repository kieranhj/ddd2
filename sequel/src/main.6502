\ main.6502 - Dare Devil Denis 2: four strips of the original, each an endless runner.
\
\ LAYER 4.2 (PLAN.md): four strips, eight keys, 50 Hz, no tearing. Each player has two keys,
\ accelerate and jump (decision 7; jump is read but not used until layer 4.3), measured in jsbeeb
\ (docs/done.md layer 4.2): Z X | V B | M , | . /, one key in each of matrix columns 1-8, so no
\ three held keys can make a phantom. Letting go of accelerate slows the rider by 1 a field
\ (decision 24, PROPOSED). Each rider has its own colours (decision 17). No jumping, collisions,
\ enemies or level types yet: obstacles pass through the riders.
\
\ THE MACHINE. Loaded at &1900 by *RUN, it copies itself down to &0E00 (`reloc`, last in the
\ file) over the DFS's workspace, and never touches the disc again. The MOS sets MODE 2 and turns
\ the cursor off; then IRQ1V is ours (the kit's irq.6502): the MOS's interrupts stop, and the
\ keys are read straight off the System VIA (the kit's keydown.6502).
\
\ THE TIMING (decision 12). Strip k's writes are to character rows 7+7k to 9+7k, which the
\ raster shows on scanlines 56+56k to 79+56k. The VSync interrupt starts System VIA T1, which
\ fires as the raster leaves each band - first 120 scanlines after the VSync edge (MODE 2: R7 =
\ 34, so the display starts 40 lines after it), then every 56 - and counts `bands`. The main
\ loop updates strip k only once `bands` > k in this field: the raster has passed its band and
\ will not be back for 288 lines (36,864 cycles).
\
\ THE SCREEN is the original's MODE 2 (docs/sequel.md): strip k's obstacles on character rows
\ 7+7k and 8+7k, its ground on 9+7k. The ground character's top four lines are lit and the same
\ at every column, so the ground is drawn once and only holes change it.
\
\ THE SCROLL. Each strip has a course position `pos` (the course column at screen column 0), in
\ 16.8 fixed point. Per field: pos += vel / 256, then vel += 1 with accelerate held, up to 250.
\ That is the original's motion exactly (update_player: x += vel x 3 / 256 and vel += 3, once
\ every 3 fields) at 3 times the rate and a third of the step (decision 16). vel < 256, so a
\ strip moves 0 or 1 column a field, and a move of one column means, for each object on screen:
\   obstacle   its shift routine (make_data.py): only the bytes that differ from one column right
\   hole       open its new left column, close the column it left (col + w)
\ and the rider redrawn if anything was written over its four columns. Objects come off
\ `first`, the first not yet gone off the left, in course order.
\
\   strip_go .. strip_done      one strip's update (X = strip), for a cycle-count breakpoint pair
\   keys_go .. keys_done        the eight keys

INCLUDE "../../src/lib/beeb.h.6502"

OSWRCH  = oswrch
LOAD_AT = &1900                 \ where *RUN puts the file
ORG_AT  = &0E00                 \ where it runs

SCREEN  = &3000
ROW     = 640                   \ bytes in a MODE 2 character row
GROUND  = &0C                   \ logical colour 2 (green) in both pixels: the land ground
RIDER   = 12                    \ the riders' fixed screen column (decision 23, PROPOSED)
VMAX    = 250                   \ the original's velocity cap (update_player)
PLAYERS = 9                     \ sprites 9 + 3p + t: player p's rider for level type t
T1_FIRST = 120 * SL - 4 * SL - 2    \ VSync edge -> band 0 left; the handler runs ~4 lines late
T1_NEXT  = 56 * SL - 2              \ one band to the next (T1 continuous: the latch reloads)

\ zero page: &70-&8F is the user's
d0       = &70                  \ 2: the top character row at a column
d1       = &72                  \ 2: the character row below it
bas      = &74                  \ 2: this strip's obstacle row
gb       = &76                  \ 2: this strip's ground row
strip    = &78
obj      = &79
col      = &7A                  \ the object's screen column, signed (-32..79)
wid      = &7B
kind     = &7C
hit      = &7D                  \ non-zero: the rider's columns were written over
cc       = &7E                  \ a sprite column, 0-3
tmp      = &7F
keys     = &80                  \ 4: accelerate held, per strip (bit 7)
jumps    = &84                  \ 4: jump held, per strip (bit 7)
vec      = &88                  \ 2: a shift routine
bands    = &8A                  \ bands the raster has left this field (the T1 hook)
field    = &8B                  \ the field this pass of the loop is for
kn       = &8C                  \ the key being read

IRQ_UNINSTALL = 0

SECTION ddd2, org = ORG_AT, load = LOAD_AT, exec = reloc - ORG_AT + LOAD_AT, filename = "!BOOT"

.start
    LDA #22 : JSR OSWRCH
    LDA #2  : JSR OSWRCH
    LDA #23 : JSR OSWRCH        \ VDU 23,1,0;0;0;0; - cursor off
    LDA #1  : JSR OSWRCH
    LDX #8
.cursor_off
    LDA #0 : JSR OSWRCH
    DEX
    BNE cursor_off
    LDX #3
.init_strip
    STX strip
    JSR draw_strip
    LDX strip
    DEX
    BPL init_strip
    JSR install_irq
    LDA frames                  \ start on a whole field
.first_field
    CMP frames
    BEQ first_field

.loop
    LDA frames                  \ one pass a field: wait for one that has not had its pass
.wait_field
    CMP field
    BNE new_field
    LDA frames
    JMP wait_field
.new_field
    STA field
    LDX #0
.strip_loop
    STX strip
    INX
.wait_band
    CPX bands                   \ until bands >= strip + 1
    BEQ band_left
    BCS wait_band
.band_left
    LDX strip
    BNE strip_go
    JSR read_keys               \ before strip 0: this field's keys
    LDX #0
.strip_go
    JSR update_strip
.strip_done
    LDX strip
    INX
    CPX #4
    BNE strip_loop
    JMP loop

\ read_keys: the eight keys into keys and jumps (bit 7 set: held).
.read_keys
.keys_go
    LDA #7
    STA kn
.rk_loop
    LDY kn
    LDX key_numbers,Y
    JSR keydown_int             \ A = &80 held, 0 not; X, Y clobbered
    LDY kn
    LDX key_slot,Y
    STA keys,X
    DEC kn
    BPL rk_loop
.keys_done
    RTS

\ the IRQ hooks (irq.6502)
.irq_vsync_hook
    INC frames
    BNE vs_count
    INC frames + 1
.vs_count
    LDA #0
    STA bands
    LDA #LO(T1_FIRST) : STA SYS_VIA_T1CL    \ (writes the latch's low byte)
    LDA #HI(T1_FIRST) : STA SYS_VIA_T1CH    \ load the counter and start
    LDA #LO(T1_NEXT)  : STA SYS_VIA_T1LL    \ then every band after it
    LDA #HI(T1_NEXT)  : STA SYS_VIA_T1LH
    RTS
.irq_timer_hook
    INC bands
    RTS

    INCLUDE "../../src/lib/irq.6502"
    INCLUDE "../../src/lib/keydown.6502"

\ ---------------------------------------------------------------------------------------------
\ update_strip: X = strip. Move it by its velocity; redraw what moved.
\ ---------------------------------------------------------------------------------------------
.us_stay
    RTS
.update_strip
    LDA finished,X
    BNE us_stay
    CLC                         \ pos += vel / 256 (the original moves, then accelerates)
    LDA pos_frac,X
    ADC vel,X
    STA pos_frac,X
    PHP
    LDA keys,X
    BPL us_coast
    LDA vel,X
    CMP #VMAX
    BCS us_speed
    INC vel,X
    BCC us_speed                \ (always: C clear from the CMP)
.us_coast
    LDA vel,X                   \ let go: slow by 1 a field (decision 24, PROPOSED)
    BEQ us_speed
    DEC vel,X
.us_speed
    PLP
    BCC us_stay                 \ under a column: nothing on the screen moves
    INC pos_lo,X
    BNE us_moved
    INC pos_hi,X
.us_moved
    LDA pos_lo,X                \ the rider at the finish: stop there (decision 22)
    CMP #LO(FINISH - RIDER)
    LDA pos_hi,X
    SBC #HI(FINISH - RIDER)
    BCC us_go
    LDA #1
    STA finished,X
    LDA #0
    STA vel,X
.us_go
    JSR set_bases
    LDA #0
    STA hit
    LDA first,X
    STA obj
.us_obj
    JSR object_column           \ col; C set: past the right edge, stop
    BCC us_here
    JMP us_end
.us_here
    BMI us_gone                 \ (N from object_column) gone off the left
    LDA kind
    BMI us_hole

    \ an obstacle. Across the edges: draw the columns on the screen. Anywhere else: its shift
    \ routine, which writes only the bytes that differ from the obstacle one column to the right.
    \ That is right everywhere but the rider's own four columns, where the screen held the rider
    \ and not the obstacle; the rider is redrawn whole after any write there (col RIDER-4 ..
    \ RIDER+3: the routine writes columns col .. col+4), and covers them completely.
    LDA col
    CMP #76
    BCS us_ob_clip              \ 76-79, or negative: part of it is off the screen
    TAX
    JSR set_dst
    LDY kind
    LDA shift_lo,Y : STA vec
    LDA shift_hi,Y : STA vec + 1
    JSR jump_vec
    LDA col
    SEC
    SBC #RIDER - 4
    CMP #8
    BCS us_ob_done
    STA hit                     \ (0-7) the rider is redrawn after
    INC hit
.us_ob_done
    JMP us_next
.us_ob_clip
    JSR draw_clipped
    LDA col
    CLC
    ADC #4
    CMP #80
    BCS us_next
    TAX
    JSR clear_column
    JMP us_next

    \ a hole: open col, close col + wid
.us_hole
    LDA col
    CMP #80
    BCS us_hole_close
    TAX
    LDA #0
    JSR ground_column
.us_hole_close
    LDA col
    CLC
    ADC wid
    CMP #80
    BCS us_next
    TAX
    LDA #GROUND
    JSR ground_column
.us_next
    INC obj
    JMP us_obj
.us_gone
    LDX strip
    LDA obj
    CMP first,X
    BNE us_next
    INC first,X
    JMP us_next
.us_end
    LDA hit
    BEQ us_rts
    JSR draw_rider
.us_rts
    RTS

\ object_column: obj's screen column for strip `strip`. Sets col, kind, wid.
\ Returns C set if it starts past the right edge (and so does every object after it); else C
\ clear, with N set if it has gone off the left (its last column, col + wid, is below 0).
.object_column
    LDX strip
    LDY obj
    LDA obj_kind,Y
    STA kind
    BMI oc_hole
    LDA #4
    BNE oc_wid
.oc_hole
    AND #&7F
.oc_wid
    STA wid
    SEC
    LDA obj_x_lo,Y
    SBC pos_lo,X
    STA col
    LDA obj_x_hi,Y
    SBC pos_hi,X
    BEQ oc_right                \ 0..255 columns on
    CMP #&FF
    BNE oc_far
    LDA col
    CMP #&E0
    BCC oc_left                 \ more than 32 back: gone
    CLC
    ADC wid                     \ col + wid < 0: gone
    BMI oc_left
    LDA #0                      \ C clear, N clear: its last column is on the screen
    CLC
    RTS
.oc_far
    BMI oc_left
.oc_past
    SEC
    RTS
.oc_right
    LDA col
    CMP #80
    BCS oc_past
    LDA #0                      \ C clear, N clear: on the screen
    RTS
.oc_left
    LDA #&FF                    \ N set
    CLC
    RTS

.jump_vec
    JMP (vec)

\ set_bases: X = strip. bas, gb.
.set_bases
    LDA obase_lo,X : STA bas
    LDA obase_hi,X : STA bas + 1
    LDA gbase_lo,X : STA gb
    LDA gbase_hi,X : STA gb + 1
    RTS

\ set_dst: X = screen column. d0 = bas + column x 8; d1 = d0 + ROW.
.set_dst
    CLC
    LDA col8_lo,X : ADC bas     : STA d0
    LDA col8_hi,X : ADC bas + 1 : STA d0 + 1
    CLC
    LDA d0     : ADC #LO(ROW) : STA d1
    LDA d0 + 1 : ADC #HI(ROW) : STA d1 + 1
    RTS

\ draw_sprite: A = sprite, X = screen column (0-76). The whole sprite, both character rows.
.draw_sprite
    TAY
    LDA spr_top_lo,Y : STA ds_top + 1
    LDA spr_top_hi,Y : STA ds_top + 2
    LDA spr_bot_lo,Y : STA ds_bot + 1
    LDA spr_bot_hi,Y : STA ds_bot + 2
    JSR set_dst
    LDY #31
.ds_loop
.ds_top
    LDA &FFFF,Y
    STA (d0),Y
.ds_bot
    LDA &FFFF,Y
    STA (d1),Y
    DEY
    BPL ds_loop
    RTS

\ draw_clipped: the obstacle `kind` at `col`, only its columns on the screen.
.draw_clipped
    LDA #0
    STA cc
.dc_loop
    LDA col
    CLC
    ADC cc
    CMP #80                     \ negative or past the edge: skip
    BCS dc_next
    TAX
    JSR set_dst
    LDA cc                      \ the column's 8 bytes start at cc x 8 in each block
    ASL A : ASL A : ASL A
    STA tmp
    LDY kind
    CLC
    LDA spr_top_lo,Y : ADC tmp : STA dc_top + 1
    LDA spr_top_hi,Y : ADC #0  : STA dc_top + 2
    CLC
    LDA spr_bot_lo,Y : ADC tmp : STA dc_bot + 1
    LDA spr_bot_hi,Y : ADC #0  : STA dc_bot + 2
    LDY #7
.dc_copy
.dc_top
    LDA &FFFF,Y
    STA (d0),Y
.dc_bot
    LDA &FFFF,Y
    STA (d1),Y
    DEY
    BPL dc_copy
.dc_next
    INC cc
    LDA cc
    CMP #4
    BNE dc_loop
    RTS

\ clear_column: X = screen column; its 16 lines, both character rows, to black.
.clear_column
    JSR set_dst
    LDA #0
    LDY #7
.cc_loop
    STA (d0),Y
    STA (d1),Y
    DEY
    BPL cc_loop
    RTS

\ ground_column: X = screen column, A = the byte for the ground's four lit lines (0: a hole).
.ground_column
    TAY
    CLC
    LDA col8_lo,X : ADC gb     : STA d0
    LDA col8_hi,X : ADC gb + 1 : STA d0 + 1
    TYA
    LDY #3
.gc_loop
    STA (d0),Y
    DEY
    BPL gc_loop
    RTS

\ draw_rider: the strip's rider at RIDER (bas set).
.draw_rider
    LDA strip                   \ player p's land rider: 9 + 3p
    ASL A
    ADC strip
    ADC #PLAYERS
    LDX #RIDER
    JMP draw_sprite

\ draw_strip: X = strip. The whole strip from scratch at its pos: the ground, every object on
\ the screen, the rider.
.draw_strip
    JSR set_bases
    LDX #79
.dw_ground
    LDA #GROUND
    JSR ground_column
    DEX
    BPL dw_ground
    LDX strip
    LDA first,X
    STA obj
.dw_obj
    JSR object_column
    BCS dw_end
    BMI dw_next
    LDA kind
    BMI dw_hole
    JSR draw_clipped
    JMP dw_next
.dw_hole
    LDA #0
    STA cc
.dw_hole_col
    LDA col
    CLC
    ADC cc
    CMP #80
    BCS dw_hole_next
    TAX
    LDA #0
    JSR ground_column
.dw_hole_next
    INC cc
    LDA cc
    CMP wid
    BNE dw_hole_col
.dw_next
    INC obj
    JMP dw_obj
.dw_end
    JMP draw_rider

\ ---------------------------------------------------------------------------------------------
\ per-strip state and constants
\ ---------------------------------------------------------------------------------------------
.obase_lo   EQUB LO(SCREEN +  7 * ROW), LO(SCREEN + 14 * ROW), LO(SCREEN + 21 * ROW), LO(SCREEN + 28 * ROW)
.obase_hi   EQUB HI(SCREEN +  7 * ROW), HI(SCREEN + 14 * ROW), HI(SCREEN + 21 * ROW), HI(SCREEN + 28 * ROW)
.gbase_lo   EQUB LO(SCREEN +  9 * ROW), LO(SCREEN + 16 * ROW), LO(SCREEN + 23 * ROW), LO(SCREEN + 30 * ROW)
.gbase_hi   EQUB HI(SCREEN +  9 * ROW), HI(SCREEN + 16 * ROW), HI(SCREEN + 23 * ROW), HI(SCREEN + 30 * ROW)
.pos_frac   EQUB 0, 0, 0, 0
.pos_lo     EQUB 0, 0, 0, 0
.pos_hi     EQUB 0, 0, 0, 0
.vel        EQUB 0, 0, 0, 0
.first      EQUB 0, 0, 0, 0
.finished   EQUB 0, 0, 0, 0
.frames     EQUW 0
.key_numbers                    \ internal key numbers, measured (docs/done.md layer 4.2)
    EQUB 97, 66, 99, 100, 101, 102, 103, 104    \ Z X V B M , . /
.key_slot                       \ where each goes: keys + p (accelerate), jumps + p (jump)
    EQUB 0, 4, 1, 5, 2, 6, 3, 7

    INCLUDE "../build/data.6502"

\ reloc: runs at its LOAD address (exec), so only relative branches until the JMP. Copies the
\ whole file from LOAD_AT down to ORG_AT, a page at a time, upwards: the destination is always
\ below the source, and this routine, last in the file, is above everything it writes.
.reloc
    SEI
    LDA #LO(LOAD_AT) : STA d0
    LDA #HI(LOAD_AT) : STA d0 + 1
    LDA #LO(ORG_AT)  : STA d1
    LDA #HI(ORG_AT)  : STA d1 + 1
    LDX #HI(end - ORG_AT + 255)
    LDY #0
.reloc_copy
    LDA (d0),Y
    STA (d1),Y
    INY
    BNE reloc_copy
    INC d0 + 1
    INC d1 + 1
    DEX
    BNE reloc_copy
    CLI
    JMP start
.end
    ASSERT ORG_AT + HI(end - ORG_AT + 255) * 256 <= SCREEN
ENDSECTION
