\ flow.6502 - the title, joining, the game, the game's end (layer 4.5b).
\
\ THE TITLE: every strip at level 1, its rider standing; "DARE DEVIL DENIS 2" at the top (strip
\ 0's sky, decision 58), each strip's keys (decision 52), and "PRESS SPACE TO START" on row 10.
\ A player joins by pressing its accelerate key: its status block appears (wages 0, the clock at
\ 120). SPACE, once someone has joined, starts the game for those who have, at level 1 (decision
\ 57: the skills B-F went). No tune (decision 58). A strip with no player stands still all game
\ (decision 14).
\ An idle strip's player can join mid-game too, at the course's start (decision 51: main.6502's
\ `join`), on the game's clock.
\ AGAINST THE CLOCK (decision 55, in place of the takes): 120 seconds for everyone; a crash costs
\ only the time it takes. When the clock is out, or every player is at the finish, row 10 says
\ "PLAYER n WINS" - the furthest along the course, then the most wages, then the first - for 250
\ fields (5 s), then the title (game_done, flow1.6502).
\
\ A rider starts at level 1's start (the original's player_x 0 on its first ground): the strip
\ cannot start left of column 0, so the rider is at column 12 of it. Labels for the oracle:
\ `game_start` (all set up, before the first field).

PHASE_IDLE = 4                  \ no one playing this strip
KEY_SPACE = 98                  \ internal key number, measured in jsbeeb (OSBYTE 121, Model B and
                                \ Master, 2026-11-15; proven on Z 97 and X 66)

\ title: the title screen, until a player has joined and SPACE is pressed; then the game.
.title
    LDA #0
    STA joined
    JSR set_up
    LDA #LO(t_title) : STA pt
    LDA #HI(t_title) : STA pt + 1
    JSR print
    JSR legend                  \ the name, each strip's keys (decision 52)
    JSR sound_quiet             \ (the title's tune went: decision 58)
.title_loop
    JSR next_field
    JSR read_keys
    LDX #3
.tl_join
    LDA keys,X                  \ accelerate held: joined (its status block drawn)
    BPL tl_next
    LDA joined
    AND bit_of,X
    BNE tl_next
    LDA joined
    ORA bit_of,X
    STA joined
    LDA #1
    STA sdirty,X
.tl_next
    DEX
    BPL tl_join
    JSR status_update
.tl_start
    LDA joined
    BEQ title_loop
    LDX #KEY_SPACE
    JSR keydown_int
    BPL title_loop
    JMP game                    \ (flow8.6502)

\ print: (pt) a text - the screen address of its first character, then glyph numbers (`font`,
\ below) and skips (G_SKIP + n: n characters on, nothing drawn; G_SPACE is one), to &FF.
\ print_at: the same with the address already in d0 and (pt) at the first glyph. Each is drawn
\ white on black, from the MOS's own font as `start` copied it through OSWORD 10 (decision 47):
\ not from &C000, which is the font only on a Model B (a Master's is elsewhere: BUGS.md #3), and
\ not through OSWRCH, whose workspace holds the game's tables from `start` on (decision 46,
\ BUGS.md #2). Rows 3-30 are cleared by screen_init, so a text need not rub out the one before.
TEXT_ROW = SCREEN + 10 * ROW    \ the black row between strips 0 and 1 (decision 42)
.print
    LDY #0
    LDA (pt),Y : STA d0
    INY
    LDA (pt),Y : STA d0 + 1
    INY
    BNE pr_from                 \ (always)
.print_at
    LDY #0
.pr_from
    STY ti
.pr_char
    LDY ti
    LDA (pt),Y
    CMP #&FF
    BEQ pr_rts
    INC ti
    LDY #1                      \ characters on after it
    CMP #G_SKIP
    BCC pr_glyph
    SBC #G_SKIP                 \ (C set) a skip: n of them
    TAY
    BNE pr_next                 \ (always: n >= 1)
.pr_glyph
    STA tmp                     \ its glyph, font + g x 7 (g to 33: 16 bits)
    LDY #0
    STY pk + 1
    ASL A : ASL A : ASL A
    ROL pk + 1
    SEC
    SBC tmp
    BCS pr_lo
    DEC pk + 1
.pr_lo
    CLC
    ADC #LO(font)
    STA pk
    LDA pk + 1
    ADC #HI(font)
    STA pk + 1
    LDY #6                      \ 7 lines: the font's eighth is blank (a comma's tail: `start`
.pr_line                        \ keeps its lines 1-7), and so is the row's
    LDA (pk),Y
    STA tmp
.pr_pair                        \ two pixels a byte, left to right: column y, y + 8, y + 16, y + 24
    LDA #0
    ASL tmp : ROL A
    ASL tmp : ROL A
    TAX
    LDA pr_white,X
    STA (d0),Y
    TYA
    ADC #8                      \ (C clear: the ROL shifted in 0)
    TAY
    CPY #32
    BCC pr_pair
    TYA                         \ y + 32, C set: the line above
    SBC #33
    TAY
    BPL pr_line
    LDY #1
.pr_next
    CLC                         \ the next character, 32 bytes on
    LDA d0
    ADC #32
    STA d0
    BCC pr_nx
    INC d0 + 1
.pr_nx
    DEY
    BNE pr_next
    BEQ pr_char                 \ (always)
.pr_rts
    RTS

\ legend: the game's name on row 4 (decision 58), then the title's key legend (decision 52). In
\ each strip's sky, its window row 1 the labels
\ and row 2 its player's keys, under them (accelerate, jump, brake: decision 49); then "ACCELERATE
\ TO JOIN" on row 17. The texts are in page 2 (the MOS's vectors), page 3 and page 8.
.legend
    LDA #LO(t_name) : STA pt
    LDA #HI(t_name) : STA pt + 1
    JSR print
    LDX #3
.lg_lane
    STX lk
    LDY wix,X
    LDA wrow_lo + 1,Y : STA d0
    LDA wrow_hi + 1,Y : STA d0 + 1
    LDA #LO(t_head) : STA pt
    LDA #HI(t_head) : STA pt + 1
    JSR print_at
    LDX lk
    LDY wix,X
    LDA wrow_lo + 2,Y : STA d0
    LDA wrow_hi + 2,Y : STA d0 + 1
    LDA lg_key_lo,X : STA pt
    LDA lg_key_hi,X : STA pt + 1
    JSR print_at
    LDX lk
    DEX
    BPL lg_lane
    LDA #LO(t_join) : STA pt
    LDA #HI(t_join) : STA pt + 1
    JMP print

\ the glyphs the texts use, in `font`'s order: the digits first, so a player's number (0-3) is
\ its own glyph. `start` fills `font` from these characters (font_chars).
G_1 = 0 : G_2 = 1 : G_3 = 2 : G_4 = 3 : G_V = 4
G_P = 5 : G_R = 6 : G_E = 7 : G_S = 8 : G_A = 9 : G_F = 10 : G_T = 11 : G_O = 12
G_L = 13 : G_Y = 14 : G_W = 15 : G_I = 16 : G_N = 17
G_C = 18 : G_J = 19 : G_U = 20 : G_M = 21 : G_B = 22 : G_K = 23 : G_H = 24 : G_Z = 25
G_X = 26 : G_G = 27 : G_COMMA = 28 : G_DOT = 29 : G_SLASH = 30 : G_5 = 31 : G_6 = 32 : G_D = 33
GLYPHS = 34
G_SKIP = &80                    \ + n: n characters on
G_SPACE = G_SKIP + 1
