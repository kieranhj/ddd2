\ flow.6502 - the title, joining, the skill, the game, the game's end (layer 4.5b).
\
\ THE TITLE: every strip at level 1, its rider standing; row 2 "PRESS A-F TO START". A player
\ joins by pressing its accelerate key: its status block appears (wages 0, takes 3). A-F, once
\ someone has joined, starts the game for those who have, at that skill's level - the original's
\ starting_levels_table: 1 7 13 19 25 31 (decision 15: one choice for everyone). A strip with no
\ player stands still all game (decision 14).
\ GAME MODE 1 (decision 8): takes, and the highest wages win. When every player is out of takes
\ or at the finish, row 2 says "PLAYER n WINS" - the most wages, the first of equals - for 250
\ fields (5 s), then the title.
\
\ A rider starts at its level's start (the original's player_x 0 on its first ground): its left
\ column there, but at level 1 the strip cannot start left of column 0, so the rider is at
\ column 12 of it. Labels for the oracle: `game_start` (all set up, before the first field).

SKILL_KEYS = 6
PHASE_IDLE = 4                  \ no one playing this strip

\ title: the title screen, until a player has joined and A-F is pressed; then the game.
.title
    LDA #0
    STA joined
    STA skill
    JSR set_up
    LDX #T_TITLE
    JSR print
    JSR tune_start              \ the title's tune (decision 40)
.title_loop
    JSR next_field
    JSR read_keys
    LDX #3
.tl_join
    LDA keys,X                  \ accelerate held: joined (its status block drawn)
    BPL tl_next
    LDA joined
    AND bit_of,X
    BNE tl_next
    LDA joined
    ORA bit_of,X
    STA joined
    LDA #1
    STA sdirty,X
.tl_next
    DEX
    BPL tl_join
    JSR status_update
    LDA joined
    BEQ title_loop
    LDA #SKILL_KEYS - 1
    STA skill
.tl_skill
    LDY skill
    LDX skill_keys,Y
    JSR keydown_int             \ A = &80 held
    BPL tl_not
    JMP game                    \ (flow8.6502)
.tl_not
    DEC skill
    BPL tl_skill
    JMP title_loop

\ print: X = an offset into `texts`: the screen address of its first character, then glyph
\ numbers (`font`, below: G_SPACE draws nothing), to &FF. Each is drawn white on black, from
\ the MOS's own font as `start` copied it through OSWORD 10 (decision 47): not from &C000, which
\ is the font only on a Model B (a Master's is elsewhere: BUGS.md #3), and not through OSWRCH,
\ whose workspace holds the game's tables from `start` on (decision 46, BUGS.md #2).
\ Row 10 is cleared by screen_init, so a text need not rub out the one before it.
TEXT_ROW = SCREEN + 10 * ROW    \ the black row between strips 0 and 1 (decision 42)
.print
    LDA texts,X : STA d0
    INX
    LDA texts,X : STA d0 + 1
.pr_char
    INX
    LDA texts,X
    CMP #&FF
    BEQ pr_rts
    STX cc
    CMP #G_SPACE
    BCS pr_next                 \ a space: nothing drawn
    STA tmp                     \ its glyph, font + g x 7
    ASL A : ASL A : ASL A
    SEC
    SBC tmp                     \ g x 7, C set (no borrow, even for g = 0)
    ADC #LO(font - 1)           \ (font - 1) + 1 + g x 7
    STA pk
    LDA #HI(font - 1)
    ADC #0
    STA pk + 1
    LDY #6                      \ 7 lines: the font's eighth is blank, and so is the row's
.pr_line
    LDA (pk),Y
    STA tmp
.pr_pair                        \ two pixels a byte, left to right: column y, y + 8, y + 16, y + 24
    LDA #0
    ASL tmp : ROL A
    ASL tmp : ROL A
    TAX
    LDA pr_white,X
    STA (d0),Y
    TYA
    ADC #8                      \ (C clear: the ROL shifted in 0)
    TAY
    CPY #32
    BCC pr_pair
    TYA                         \ y + 32, C set: the line above
    SBC #33
    TAY
    BPL pr_line
.pr_next
    CLC                         \ the next character, 32 bytes on
    LDA d0
    ADC #32
    STA d0
    BCC pr_nx
    INC d0 + 1
.pr_nx
    LDX cc
    BNE pr_char                 \ (always: X > 0)
.pr_rts
    RTS

\ the glyphs the texts use, in `font`'s order: the digits first, so a player's number (0-3) is
\ its own glyph. `start` fills `font` from these characters.
G_1 = 0 : G_2 = 1 : G_3 = 2 : G_4 = 3 : G_DASH = 4
G_P = 5 : G_R = 6 : G_E = 7 : G_S = 8 : G_A = 9 : G_F = 10 : G_T = 11 : G_O = 12
G_L = 13 : G_Y = 14 : G_W = 15 : G_I = 16 : G_N = 17
GLYPHS = 18
G_SPACE = &80

T_TITLE = t_title - texts
T_WINS = t_wins - texts
