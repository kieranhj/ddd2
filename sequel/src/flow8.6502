\ flow8.6502 - flow.6502's set-up and printing, assembled for page 8: main.6502's start copies
\ it there once install_irq has flushed the MOS's buffers (nothing writes the page after;
\ decision 32).

\ set_up: every strip at skill `skill`'s level; the joined ones to play, the rest idle; all drawn.
.set_up
    JSR screen_init
    JSR enemy_init
    JSR status_init
    LDX #3
.su_strip
    STX strip
    JSR strip_init
    JSR draw_strip
    LDX strip
    DEX
    BPL su_strip
    RTS

\ strip_init: X = strip. Its state at the start of skill `skill`'s level. X kept.
.strip_init
    LDY skill
    LDA start_lo,Y
    STA pos_lo,X
    LDA start_hi,Y
    STA pos_hi,X
    LDA start_lidx,Y
    ASL A
    ASL A
    STA gcount,X                \ the grounds before the rider's level
    LDA edge_lidx,Y             \ the level at the strip's left edge: 12 columns back, the one
    STA lidx,X                  \ before (but at level 1), and its type
    LDA edge_ltype,Y
    STA ltype,X
    LDA edge_nb_lo,Y            \ and the next level's start after it
    STA nb_lo,X
    LDA edge_nb_hi,Y
    STA nb_hi,X
    LDA #0
    STA pos_frac,X
    STA vel,X
    STA js,X
    STA finished,X
    STA ct,X
    STA rtype,X                 \ every starting level is land: (1 + 6k - 1) MOD 3 = 0
    STA first,X
    LDA #&FF                    \ its look buffer: to be made
    STA look,X
    LDA #SKY
    STA drawn_t,X
    LDA #1
    STA take,X
    CLC                         \ the rider's level's start: rl = it + 304, wg = it + 76
    LDA level_lo,Y
    ADC #LO(LEVEL_COLS)
    STA rl_lo,X
    LDA level_hi,Y
    ADC #HI(LEVEL_COLS)
    STA rl_hi,X
    CLC
    LDA level_lo,Y
    ADC #76
    STA wg_lo,X
    LDA level_hi,Y
    ADC #0
    STA wg_hi,X
    LDA joined                  \ playing (its status block drawn), or idle (none)
    AND bit_of,X
    BEQ si_idle
    LDA #1
    STA sdirty,X
    LDA #0
    BEQ si_phase
.si_idle
    LDA #0
    STA sdirty,X
    LDA #PHASE_IDLE
.si_phase
    STA phase,X
.si_first                       \ first: past the objects gone off the left
    LDA first,X
    STA obj
    JSR object_column
    BCS si_rts
    BPL si_rts
    LDX strip
    INC first,X
    JMP si_first
.si_rts
    LDX strip
    RTS

\ next_field: wait for the next field.
.next_field
    LDA frames
.nf_wait
    CMP frames
    BEQ nf_wait
    STA field
    RTS

\ print's (flow.6502) two pixels a byte, white: neither, the right, the left, both (MODE 2)
.pr_white   EQUB &00, &15, &2A, &3F
