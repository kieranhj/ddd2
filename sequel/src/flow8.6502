\ flow8.6502 - flow.6502's set-up and printing, assembled for page 8: main.6502's start copies
\ it there once install_irq has flushed the MOS's buffers (nothing writes the page after;
\ decision 32).

\ set_up: every strip at level 1; the joined ones to play, the rest idle; all drawn.
.set_up
    JSR screen_init
    JSR enemy_init
    JSR status_init
    LDX #3
.su_strip
    STX strip
    JSR strip_init
    JSR draw_strip
    LDX strip
    DEX
    BPL su_strip
    RTS

\ game (flow.6502's): everyone joined, at level 1 (decision 57: skill A only); the clock from
\ 120 seconds, its first step 50 fields after the first pass's (decision 55); the loop.
.game
    JSR sound_quiet
    JSR set_up
    LDA #0
    STA pass_count
    STA pass_count + 1
.game_start
    JSR next_field              \ start on a whole field (A: the field before it)
    CLC
    ADC #51
    STA clk_next
    JMP loop

\ strip_init: X = strip. Its state at the start of level 1: the strip's left edge at course
\ column 0, the rider at column 12 (the original's player_x 0). X kept.
.strip_init
    LDA #0
    STA pos_lo,X
    STA pos_hi,X
    STA gcount,X                \ the grounds before the rider's level
    STA lidx,X                  \ the level at the strip's left edge, and its type
    STA ltype,X
    STA pos_frac,X
    STA vel,X
    STA js,X
    STA finished,X
    STA ct,X
    STA rtype,X                 \ level 1 is land
    STA first,X
    STA nb_hi,X                 \ and the next level's start after it
    STA wg_hi,X                 \ the rider's first ground's end, and its next level's start
    STA rl_hi,X
    LDA #LO(LEVEL_COLS)
    STA nb_lo,X
    STA rl_lo,X
    ASSERT HI(LEVEL_COLS) = 1
    INC nb_hi,X
    INC rl_hi,X
    LDA #76
    STA wg_lo,X
    LDA #&FF                    \ its look buffer: to be made
    STA look,X
    LDA #SKY
    STA drawn_t,X
    LDA joined                  \ playing (its status block drawn), or idle (none)
    AND bit_of,X
    BEQ si_idle
    LDA #1
    STA sdirty,X
    LDA #0
    BEQ si_phase
.si_idle
    LDA #0
    STA sdirty,X
    LDA #PHASE_IDLE
.si_phase
    STA phase,X
.si_first                       \ first: past the objects gone off the left
    LDA first,X
    STA obj
    JSR object_column
    BCS si_rts
    BPL si_rts
    LDX strip
    INC first,X
    JMP si_first
.si_rts
    LDX strip
    JMP mark_phase              \ its markers' place (marks.6502)

\ next_field: wait for the next field.
.next_field
    LDA frames
.nf_wait
    CMP frames
    BEQ nf_wait
    STA field
    RTS


\ the legend's (flow.6502, decision 52) keys, a text a strip, centred under its labels (t_head:
\ ACCEL at character columns 2-6, JUMP 8-11, BRAKE 13-17). `start` puts t_k4b in for player 4
\ on a machine with no keypad.
\ take_gold: X = a gold (enemy slot x 10 + E_GOLD + k) the rider of strip `strip` touches
\ (collide, decision 53): gone, 80 wages, the 80 over the rider's left column (collect_gold's).
.take_gold
    TXA
    LDY #0
.tg_slot
    CMP #PER_SLOT
    BCC tg_k
    SBC #PER_SLOT               \ (C set)
    INY
    BNE tg_slot                 \ (always)
.tg_k
    SEC
    SBC #E_GOLD
    STA hc + 3                  \ gold k
    STY es
    JSR slot_g                  \ eg
    JMP cg_found                \ (specials.6502)

.lg_key_lo  EQUB LO(t_k1), LO(t_k2), LO(t_k3), LO(t_k4)
.lg_key_hi  EQUB HI(t_k1), HI(t_k2), HI(t_k3), HI(t_k4)
.t_k1       EQUB G_SKIP + 2, G_S, G_H, G_I, G_F, G_T, G_SKIP + 2, G_Z, G_SKIP + 5, G_X, &FF
.t_k4       EQUB G_SKIP + 4, G_4, G_SKIP + 4, G_5, G_SKIP + 5, G_6, &FF     \ the keypad's
