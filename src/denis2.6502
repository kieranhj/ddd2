\ denis2.6502 - DENIS2 from &40E9, after its BASIC: the tune player, loading screen and leftovers
\
\ Created once by tools/disasm2baron.py from Level7's disassembly,
\ reference/dare-devil-denis-disassembly.txt (lines starting "\ " carry its annotations).
\ Hand-maintained from here on. INCLUDEd inside its SECTION by src/main.6502.

    EQUB &FF    \ End of BASIC program

    EQUB &32, &00, &00, &8B, &00, &00, &00, &00

    EQUB &32, &31, &0D    \ ... 21

    EQUB &00, &78, &09, &20, &2A, &52, &55, &4E, &0D    \ 120 *RUN

    EQUB &FF    \ End of BASIC program

    EQUB &31, &33, &2C, &32, &33, &2C, &33, &39, &2C, &32, &31, &0D    \ ... 13,23,39,21

    EQUB &00, &78, &09, &20, &2A, &52, &55, &4E, &0D    \ 120 *RUN

    EQUB &FF    \ End of BASIC program

    EQUB &33, &00, &00, &87, &32, &00, &00, &00

    EQUB &37, &2C, &31, &35, &0D    \ ... 7,15

    EQUB &00, &78, &09, &20, &2A, &52, &55, &4E, &0D    \ 120 *RUN

    EQUB &FF    \ End of BASIC program

    EQUB &0D, &00, &00, &8B, &00, &00, &00, &00

    EQUB &30, &2C, &32, &30, &2C, &33, &30, &2C, &31, &37, &0D    \ ... 0,20,30,17

    EQUB &00, &6E, &09, &20, &2A, &52, &55, &4E, &0D    \ 110 *RUN

    EQUB &FF    \ End of BASIC program

    EQUB &31, &00, &00, &8C, &75, &00, &00

.event_handler
    DEC tune_cooldown
    LDA tune_cooldown
    CMP #&00
    BEQ update_tune
    RTS
.update_tune
    CLC
    LDA tune_address_low
    ADC #&03
    STA tune_address_low
    LDA tune_address_high
    ADC #&00
    STA tune_address_high
    LDY #&00
    LDA (tune_address),Y            \ First byte of tune data specifies pitch
    CMP #&00                        \ Zero indicates end of tune
    BNE not_end_of_tune
.restart_tune
    LDA #LO(tune_data_4204 - 3)
    STA tune_address_low
    LDA #&42
    STA tune_address_high
    LDA #&01
    STA tune_cooldown
    RTS
.not_end_of_tune
    LDA #&11                        \ Play immediately on channel 1
    STA sound_block_0c00            \ (channel)
    LDA #&00
    STA sound_block_0c00 + 1        \ (channel high)
    LDA #&F1
    STA sound_block_0c00 + 2        \ (volume)
    LDA #&FF
    STA sound_block_0c00 + 3        \ (volume high)
    LDY #&00
    LDA (tune_address),Y            \ First byte of tune data specifies first pitch
    STA sound_block_0c00 + 4        \ (pitch)
    LDA #&00
    STA sound_block_0c00 + 5        \ (pitch high)
    LDA #&FF
    STA sound_block_0c00 + 6        \ (duration)
    LDA #&00
    STA sound_block_0c00 + 7        \ (duration high)
    LDX #LO(sound_block_0c00)
    LDY #&0C
    LDA #&07                        \ Generate a sound
    JSR OSWORD                      \ OSWORD    Play first note in chord on channel one
    LDA #&12                        \ Play immediately on channel 2
    STA sound_block_0c00            \ (channel)
    LDA #&00
    STA sound_block_0c00 + 1        \ (channel high)
    LDA #&F1
    STA sound_block_0c00 + 2        \ (volume)
    LDA #&FF
    STA sound_block_0c00 + 3        \ (volume high)
    LDY #&01
    LDA (tune_address),Y            \ Second byte of tune data specifies second pitch
    STA sound_block_0c00 + 4        \ (pitch)
    LDA #&00
    STA sound_block_0c00 + 5        \ (pitch high)
    LDA #&FF
    STA sound_block_0c00 + 6        \ (duration)
    LDA #&00
    STA sound_block_0c00 + 7        \ (duration high)
    LDX #LO(sound_block_0c00)
    LDY #&0C
    LDA #&07                        \ Generate a sound
    JSR OSWORD                      \ OSWORD    Play second note in chord on channel two
    LDY #&02
    LDA (tune_address),Y            \ Third byte of tune data specifies duration
    STA tune_cooldown
    CLC
    LDA tune_cooldown
    ADC tune_cooldown
    STA tune_cooldown
    CLC
    LDA tune_cooldown
    ADC tune_cooldown
    STA tune_cooldown
    CLC
    LDA tune_cooldown
    ADC (tune_address),Y
    STA tune_cooldown
    CLC
    LDA tune_cooldown
    ADC (tune_address),Y
    STA tune_cooldown
    RTS

