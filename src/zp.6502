skill                                    = &70
skill_letter                             = &70
source_address                           = &70
source_address_low_0070                  = &70
starting_level                           = &70
target_address_low_0070                  = &70
title_screen_colour                      = &70
tune_address                             = &70
tune_address_low                         = &70
tune_data_address                        = &70
tune_data_address_low                    = &70
level_type_data_addresses_address_high   = &71
lines_remaining                          = &71
screen_address_high                      = &71
screen_address_y                         = &71
skill_y                                  = &71
source_address_high_0071                 = &71
start_screen_colour_one                  = &71
suppress_leading_zeroes                  = &71
target_address_high_0071                 = &71
tune_address_high                        = &71
tune_data_address_high                   = &71
duration                                 = &72
source_address_low_0072                  = &72
sprite_address                           = &72
sprite_address_low                       = &72
start_screen_colour_two                  = &72
target_address                           = &72
