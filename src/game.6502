.calculate_player_screen_address
    LDA player_x
    STA screen_x
    LDA player_ground_y
    STA screen_y
    LDX player_jump_state
    SEC
    LDA screen_y
    SBC jump_offsets_table,X
    STA screen_y
    JSR calculate_screen_address
    LDA screen_address_low
    STA player_screen_address_low
    LDA screen_address_high
    STA player_screen_address_high
    LDA row_in_group
    STA player_row_in_group
    RTS

.replot_player
    LDA player_x
    STA screen_x
    LDA player_ground_y
    STA screen_y
    LDX player_jump_state
    SEC
    LDA screen_y
    SBC jump_offsets_table,X
    STA screen_y
    LDA #LO(sprite_blank)
    STA sprite_address_low
    LDA #&27
    STA sprite_address_high
    LDA #&13                        \ Wait for vertical retrace
    JSR OSBYTE                      \ OSBYTE
    LDA player_screen_address_low
    STA screen_address_x
    LDA player_screen_address_high
    STA screen_address_y
    LDA player_row_in_group
    STA row_in_group
    JSR plot_sprite                 \ Unplot previous player
    JSR calculate_screen_address
    LDA player_sprite_address_low
    STA sprite_address_low
    LDA player_sprite_address_high
    STA sprite_address_high
    JSR plot_sprite                 \ Plot player
    RTS

