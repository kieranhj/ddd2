    EQUB &00, &00, &D0, &16, &31

.collect_gold
    LDA player_x
    STA screen_x
    SEC
    LDA player_ground_y
    SBC #&20
    STA screen_y
    LDA #LO(sprite_eighty)
    STA sprite_address_low
    LDA #&17
    STA sprite_address_high
    JSR calculate_screen_address
    JSR plot_sprite                 \ Plot 80
    LDA #&08
    STA count_0070
.add_eighty_to_wages_loop
    JSR add_to_wages                \ Earn 80 (10 * 8) for collecting gold
    DEC count_0070
    BNE add_eighty_to_wages_loop
    LDA #LO(sprite_blank)
    STA sprite_address_low
    LDA #&27
    STA sprite_address_high
    LDA player_x
    STA screen_x
    INC screen_x
    INC screen_x
    LDA player_ground_y
    STA screen_y
    JSR calculate_screen_address
    JSR plot_sprite                 \ Unplot gold
    LDA #&12                        \ Play immediately on channel 2
    STA sound_block_0c30            \ (channel)
    LDA #&00
    STA sound_block_0c30 + 1        \ (channel high)
    LDA #&02
    STA sound_block_0c30 + 2        \ (volume)
    LDA #&00
    STA sound_block_0c30 + 3        \ (volume high)
    LDA #&C8
    STA sound_block_0c30 + 4        \ (pitch)
    LDA #&00
    STA sound_block_0c30 + 5        \ (pitch high)
    LDA #&01
    STA sound_block_0c30 + 6        \ (duration)
    LDA #&00
    STA sound_block_0c30 + 7        \ (duration high)
    LDX #LO(sound_block_0c30)
    LDY #&0C
    LDA #&07                        \ Generate a sound
    JSR OSWORD                      \ OSWORD    Play sound for collecting gold
    RTS

