.title_screen
    LDA #&16                        \ Change to MODE 7
    JSR OSWRCH                      \ OSWRCH
    LDA #&07
    JSR OSWRCH                      \ OSWRCH
    JSR disable_cursor
    LDA #LO(screen_memory_7c00)
    STA target_address_low_0070
    LDA #&7C
    STA target_address_high_0071
    LDA #LO(title_screen_data)
    STA source_address_low_0072
    LDA #&30
    STA source_address_high_0073
    LDY #&00
.copy_title_screen_loop
    LDA (target_address),Y
    STA (source_address),Y
    INY
    BNE copy_title_screen_loop
    INC source_address_high_0073
    INC target_address_high_0071
    LDA target_address_high_0071
    CMP #&80
    BNE copy_title_screen_loop
    LDX #&00
.title_screen_loop
    STX title_screen_colour
    LDX #&02
    LDY #&00
    LDA #&81                        \ Wait for input character
    JSR OSBYTE                      \ OSBYTE
    CPX #&20                        \ " "
    BEQ to_start_screen
    LDA #&13                        \ Wait for vertical retrace
    JSR OSBYTE                      \ OSBYTE
    LDX title_screen_colour
    LDA #&1F                        \ TAB(&0c, &17)
    JSR OSWRCH                      \ OSWRCH
    LDA #&0C
    JSR OSWRCH                      \ OSWRCH
    LDA #&17
    JSR OSWRCH                      \ OSWRCH
    CLC
    LDA start_screen_colours_table,X
    ADC #&80                        \ TELETEXT_TEXT_COLOUR
    JSR OSWRCH                      \ OSWRCH
    INX
    CPX #&0B
    BNE title_screen_loop
    LDX #&00
    JMP title_screen_loop

.to_start_screen
    JSR start_screen

.entry_point
    LDA #&0D                        \ Disable event
    LDX #&04                        \ v-sync event
    JSR OSBYTE                      \ OSBYTE
    LDA #&0F                        \ Flush all buffers
    LDX #&00                        \ all buffers
    JSR OSBYTE                      \ OSBYTE
    JMP title_screen

