.calculate_screen_address
    LDA #LO(screen_memory_3000)
    STA screen_address_low
    LDA #&30
    STA screen_address_high
    LDX #&02
.add_columns_loop
    CLC
    LDA screen_address_low
    ADC screen_x                    \ screen_address += screen_x * 8
    STA screen_address_low
    LDA screen_address_high
    ADC #&00
    STA screen_address_high
    CLC
    LDA screen_address_low
    ADC screen_x
    STA screen_address_low
    LDA screen_address_high
    ADC #&00
    STA screen_address_high
    CLC
    LDA screen_address_low
    ADC screen_x
    STA screen_address_low
    LDA screen_address_high
    ADC #&00
    STA screen_address_high
    CLC
    LDA screen_address_low
    ADC screen_x
    STA screen_address_low
    LDA screen_address_high
    ADC #&00
    STA screen_address_high
    DEX
    BNE add_columns_loop
    LDA screen_y
    AND #&07
    STA row_in_group
    LSR screen_y
    LSR screen_y
    LSR screen_y
    LDX screen_y
    CPX #&00
    BEQ skip_adding_groups
.add_groups_loop
    CLC
    LDA screen_address_low
    ADC #&80
    STA screen_address_low
    LDA screen_address_high
    ADC #&02
    STA screen_address_high
    DEX
    BNE add_groups_loop
.skip_adding_groups
    RTS

.plot_sprite
    LDA #&00
    STA sprite_offset
    STA rows_plotted
    CLC
    LDA screen_address_low
    ADC row_in_group
    STA screen_address_low
    LDA screen_address_high
    ADC #&00
    STA screen_address_high
.plot_sprite_row_loop
    LDY sprite_offset
    LDA (sprite_address),Y
    LDY #&00
    STA (screen_address),Y
    INC sprite_offset
    LDY sprite_offset
    LDA (sprite_address),Y
    LDY #&08
    STA (screen_address),Y
    INC sprite_offset
    LDY sprite_offset
    LDA (sprite_address),Y
    LDY #&10
    STA (screen_address),Y
    INC sprite_offset
    LDY sprite_offset
    LDA (sprite_address),Y
    LDY #&18
    STA (screen_address),Y
    INC sprite_offset
    INC row_in_group
    LDY #&20
    LDA (screen_address),Y
    STA right_edge
    CLC
    LDA screen_address_low
    ADC #&01                        \ Move down a row
    STA screen_address_low
    LDA screen_address_high
    ADC #&00
    STA screen_address_high
    INC rows_plotted
    LDA #&10
    CMP rows_plotted
    BNE not_end_of_sprite
    LDA #&01
    CMP #&01
    BEQ leave_after_storing_bottom_edge\ Always branches
.not_end_of_sprite
    LDA row_in_group
    CMP #&08
    BNE plot_sprite_row_loop
.next_group
    CLC
    LDA screen_address_low
    ADC #&78                        \ Move down a group
    STA screen_address_low
    LDA screen_address_high
    ADC #&02
    STA screen_address_high
    LDA #&00
    STA row_in_group
    LDA #&01
    CMP #&01
    BEQ plot_sprite_row_loop        \ Always branches
.leave_after_storing_bottom_edge
    LDY #&00
    LDA (screen_address),Y
    STA bottom_edge
    LDY #&08
    LDA (screen_address),Y
    STA bottom_edge + 1             \ Unused variable
    LDY #&10
    LDA (screen_address),Y
    STA bottom_edge + 2             \ Unused variable
    LDY #&18
    LDA (screen_address),Y
    STA bottom_edge + 3
    RTS

