.disable_cursor
    LDA #&17
    JSR OSWRCH                      \ OSWRCH
    LDA #&00                        \ set CRTC register
    JSR OSWRCH                      \ OSWRCH
    LDA #&0A                        \ R10: Cursor start register
    JSR OSWRCH                      \ OSWRCH
    LDA #&20                        \ disable cursor
    JSR OSWRCH                      \ OSWRCH
    LDY #&08
.write_nulls_loop
    LDA #&00
    JSR OSWRCH                      \ OSWRCH
    DEY
    BNE write_nulls_loop
    RTS

.play_tune
    LDA #&12
    STA tune_notes_remaining
    LDA #LO(tune_data_2f68)
    STA tune_data_address_low
    LDA #&2F
    STA tune_data_address_high
.play_tune_loop
    LDY #&02
    LDA (tune_data_address),Y       \ Third byte of tune data specifies duration
    STA duration
    CLC
    LDA duration
    ADC duration
    STA duration
    CLC
    LDA duration
    LDY #&02
    ADC (tune_data_address),Y       \ Third byte of tune data specifies duration
    STA duration                    \ Multiply by three
    LDY #&01
    LDA (tune_data_address),Y       \ Second byte of tune data specifies pitch
    CMP #&00                        \ Zero if delay
    BNE is_note
.is_delay
    LDA #&2D                        \ 45
    STA tune_delay
.tune_delay_loop
    LDA #&13                        \ Wait for vertical retrace
    JSR OSBYTE                      \ OSBYTE
    DEC tune_delay
    BNE tune_delay_loop
    JMP move_to_next_note
.is_note
    LDA #&01
    STA sound_block_0c30            \ (channel)
    LDA #&00
    STA sound_block_0c30 + 1        \ (channel high)
    LDA #&F1
    STA sound_block_0c30 + 2        \ (volume)
    LDA #&FF
    STA sound_block_0c30 + 3        \ (volume high)
    LDY #&00
    LDA (tune_data_address),Y       \ First byte of tune data specifies first pitch
    STA sound_block_0c30 + 4        \ (pitch)
    LDA #&00
    STA sound_block_0c30 + 5        \ (pitch high)
    LDA duration
    STA sound_block_0c30 + 6        \ (duration)
    LDA #&00
    STA sound_block_0c30 + 7        \ (duration high)
    LDX #LO(sound_block_0c30)
    LDY #&0C
    LDA #&07                        \ Generate a sound
    JSR OSWORD                      \ OSWORD    Play first note in chord on channel one
    LDA #&02
    STA sound_block_0c30            \ (channel)
    LDA #&00
    STA sound_block_0c30 + 1        \ (channel high)
    LDA #&F1
    STA sound_block_0c30 + 2        \ (volume)
    LDA #&FF
    STA sound_block_0c30 + 3        \ (volume high)
    LDY #&01
    LDA (tune_data_address),Y       \ Second byte of tune data specifies second pitch
    STA sound_block_0c30 + 4        \ (pitch)
    LDA #&00
    STA sound_block_0c30 + 5        \ (pitch high)
    LDA duration
    STA sound_block_0c30 + 6        \ (duration)
    LDA #&00
    STA sound_block_0c30 + 7        \ (duration high)
    LDX #LO(sound_block_0c30)
    LDY #&0C
    LDA #&07                        \ Generate a sound
    JSR OSWORD                      \ OSWORD    Play second note in chord on channel two
.move_to_next_note
    CLC
    LDA tune_data_address_low
    ADC #&03
    STA tune_data_address_low
    LDA tune_data_address_high
    ADC #&00
    STA tune_data_address_high
    DEC tune_notes_remaining
    BEQ end_of_tune
    JMP play_tune_loop
.end_of_tune
    LDA #&32                        \ 50
    STA tune_delay
.end_of_tune_delay_loop
    LDA #&13                        \ Wait for vertical retrace
    JSR OSBYTE                      \ OSBYTE
    DEC tune_delay
    BNE end_of_tune_delay_loop
    RTS

