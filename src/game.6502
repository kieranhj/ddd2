    LDA screen_address_high
    PHA
    LDA row_in_group
    PHA
    DEC helicopter_x
    LDA helicopter_x
    CMP #&00
    BNE skip_changing_helicopter_ground
    LDA #&4C
    STA helicopter_x                \ Move to right of screen
    SEC
    LDA helicopter_y
    SBC #&38                        \ Move up a ground
    STA helicopter_y
    LDA helicopter_y
    CMP #&EF
    BNE skip_ground_wraparound      \ If above first ground,
    LDA #&CF                        \ Move to fourth ground
    STA helicopter_y
    LDA level
    STA next_gold_position_offset
.skip_ground_wraparound
.skip_changing_helicopter_ground
    LDA #LO(sprite_blank)
    STA sprite_address_low
    LDA #&27
    STA sprite_address_high
    PLA
    STA row_in_group
    PLA
    STA screen_address_high
    PLA
