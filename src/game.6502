    STA player_screen_address_high
    LDA row_in_group
    STA player_row_in_group

.kill_player
    LDA #&10                        \ Play immediately on channel 0
    STA sound_block_0c30            \ (channel)
    LDA #&00
    STA sound_block_0c30 + 1        \ (channel high)
    LDA #&01
    STA sound_block_0c30 + 2        \ (volume)
    LDA #&00
    STA sound_block_0c30 + 3        \ (volume high)
    LDA #&06                        \ Low frequency white noise
    STA sound_block_0c30 + 4        \ (pitch)
    LDA #&00
    STA sound_block_0c30 + 5        \ (pitch high)
    LDA #&05
    STA sound_block_0c30 + 6        \ (duration)
    LDA #&00
    STA sound_block_0c30 + 7        \ (duration high)
    LDX #LO(sound_block_0c30)
    LDY #&0C
    LDA #&07                        \ Generate a sound
    JSR OSWORD                      \ OSWORD    Play sound for player dying
    LDA #&9A                        \ &009a    Unnecessary code; values overwritten at &1a57
    STA player_sprite_address_low
    LDA #&00
    STA player_sprite_address_high
    LDA player_x
    STA screen_x
    LDA player_ground_y
    STA screen_y
    LDX player_jump_state
    LDA screen_y
    SBC jump_offsets_table,X
    STA screen_y
    LDA #LO(sprite_explosion)
    STA sprite_address_low
    LDA #&27
    STA sprite_address_high
    JSR calculate_screen_address
    JSR plot_sprite                 \ Plot explosion
    CLC
    LDA player_x
    ADC #&04
    STA player_x
    LDA #&12
    STA player_jump_state           \ Set player starting to fall
.animate_flying_dead_player_loop
    JSR update_rotating_colour_and_enemies
    LDA #&13                        \ Wait for vertical retrace
    JSR OSBYTE                      \ OSBYTE
    LDA player_x
    STA screen_x
    LDA player_ground_y
    STA screen_y
    LDX player_jump_state
    LDA screen_y
    SBC jump_offsets_table,X
    STA screen_y
    LDA #LO(sprite_blank)           \ Unnecessary code
