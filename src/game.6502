\ ;      A  B  C  D  E  F                                             # B: Experienced   starts on level  7 (set 3)
.starting_levels_table    \ A: Novice        starts on level  1 (set 1)
    EQUB &01, &07, &0D, &13, &19, &1F    \ C: Expert        starts on level 13 (set 5)
\ # D: Oscar Nominee starts on level 19 (set 7)
\ # E: Oscar Winner  starts on level 25 (set 9)
\ # F: Ace           starts on level 31 (set 11)

.start_screen
    LDA #&0F                        \ Flush all buffers
    LDX #&00                        \ all buffers
    JSR OSBYTE                      \ OSBYTE
    LDA #&0D                        \ Disable event
    LDX #&04                        \ v-sync event
    JSR OSBYTE                      \ OSBYTE
    LDY #&00
    LDA #&DC                        \ Read/Write ASCII for ESCAPE
    LDX #&FF                        \ Set Escape character to &ff
    JSR OSBYTE                      \ OSBYTE
    LDA #&16                        \ Change to MODE 7
    JSR OSWRCH                      \ OSWRCH
    LDA #&07
    JSR OSWRCH                      \ OSWRCH
    JSR disable_cursor
    LDX #&00
    LDA #&1F                        \ TAB(&0a, &05)
    JSR OSWRCH                      \ OSWRCH
    LDA #&0A
    JSR OSWRCH                      \ OSWRCH
    LDA #&05
    JSR OSWRCH                      \ OSWRCH
.write_how_good_are_you_loop
    LDA start_screen_text,X
    CMP #&0D                        \ CR
    BEQ write_skills
    JSR OSWRCH                      \ OSWRCH    Write "How good are you"
    INX
    JMP write_how_good_are_you_loop
.write_skills
    INX
    LDA #&41                        \ "A"
    STA skill_letter
    LDA #&07
    STA skill_y
.write_skills_loop
    LDA #&1F                        \ TAB(&0c, skill_y)
    JSR OSWRCH                      \ OSWRCH
    LDA #&0C
    JSR OSWRCH                      \ OSWRCH
    LDA skill_y
    JSR OSWRCH                      \ OSWRCH
    LDA #&86                        \ TELETEXT_CYAN
    JSR OSWRCH                      \ OSWRCH
    LDA skill_letter
    JSR OSWRCH                      \ OSWRCH    Write skill letter
    LDA #&29                        \ ")"
    JSR OSWRCH                      \ OSWRCH
    LDA #&83                        \ TELETEXT_YELLOW
    JSR OSWRCH                      \ OSWRCH
.write_skill_loop
    LDA start_screen_text,X
    CMP #&0D                        \ CR
    BEQ consider_next_skill
    JSR OSWRCH                      \ OSWRCH    Write skill description
    INX
    JMP write_skill_loop
.consider_next_skill
    INX
    INC skill_y
    INC skill_y
    INC skill_letter
    LDA skill_letter
    CMP #&47                        \ "G"
    BNE write_skills_loop
.write_start_screen_text
    LDA #&1F                        \ TAB(&04, &13)
    JSR OSWRCH                      \ OSWRCH
    LDA #&04
    JSR OSWRCH                      \ OSWRCH
    LDA #&13
    JSR OSWRCH                      \ OSWRCH
    LDA #&02
    STA lines_remaining
.write_start_screen_text_loop
    LDA start_screen_text,X
    CMP #&0D                        \ CR
    BEQ consider_next_line
    JSR OSWRCH                      \ OSWRCH    Write "To start press A to F"
    INX                             \ and "Highest wages paid today"
    JMP write_start_screen_text_loop
.consider_next_line
    INX
    DEC lines_remaining
    BNE write_start_screen_text_loop
.check_for_new_highest_wages
    LDX #&00
.check_for_new_highest_wages_loop
    LDA highest_wages,X
    CMP wages,X
    BEQ consider_next_digit_0fb5
    BCC is_new_highest_wages
    JMP not_new_highest_wages
.consider_next_digit_0fb5
    INX
    CPX #&06
    BNE check_for_new_highest_wages_loop
    JMP not_new_highest_wages
.unused_0fbd
    LDX #&00                        \ Unused code
.is_new_highest_wages
    LDX #&00
.set_highest_wages_loop
    LDA wages,X
    STA highest_wages,X
    INX
    CPX #&06
    BNE set_highest_wages_loop
.not_new_highest_wages
    LDA #&20                        \ " "
    JSR OSWRCH                      \ OSWRCH
    LDA #&60                        \ "£"
    JSR OSWRCH                      \ OSWRCH
    LDX #&00
    LDA #&01
    STA suppress_leading_zeroes
.write_highest_wages_loop
    LDA highest_wages,X
    CMP #&30                        \ "0"
    BNE not_leading_zero
    LDA suppress_leading_zeroes
    CMP #&00
    BEQ not_leading_zero
    CPX #&05
    BEQ not_leading_zero
    JMP consider_next_digit_0ffa
.not_leading_zero
    LDA #&00
    STA suppress_leading_zeroes
    LDA highest_wages,X
    JSR OSWRCH                      \ OSWRCH    Write highest wages
.consider_next_digit_0ffa
    INX
    CPX #&06
    BNE write_highest_wages_loop
    LDX #&00
    LDA #&07
    STA start_screen_y
    LDA #&00
    STA start_screen_colour_one
    LDA #&07
    STA start_screen_colour_two
    LDA #&04
    STA scrolltext_cooldown
.start_screen_loop
    LDA #&81                        \ Wait for input character
    LDX #&02
    LDY #&00
    JSR OSBYTE                      \ OSBYTE
    TXA
    SEC
    SBC #&41                        \ "A"
    STA skill
    JMP skip_updating_bottom_colour
.unused_1023    \ Unused code; would rotate colours in "To start press A to F"
    LDX start_screen_colour_one
    LDA #&1F                        \ TAB(&19, &13)
    JSR OSWRCH                      \ OSWRCH
    LDA #&19                        \ Bug: should be LDA    &18 to set colour for "A"
    JSR OSWRCH                      \ OSWRCH
    LDA #&13
    JSR OSWRCH                      \ OSWRCH
    LDA start_screen_colours_table,X
    ADC #&80                        \ TELETEXT_TEXT_COLOUR
    JSR OSWRCH                      \ OSWRCH
    LDX start_screen_colour_two
    LDA #&1F                        \ TAB(&1e, &13)
    JSR OSWRCH                      \ OSWRCH
    LDA #&1E                        \ Bug: should be LDA    &1d to set colour for "F"
    JSR OSWRCH                      \ OSWRCH
    LDA #&13
    JSR OSWRCH                      \ OSWRCH
    LDA start_screen_colours_table,X
    ADC #&80                        \ TELETEXT_TEXT_COLOUR
    JSR OSWRCH                      \ OSWRCH
.skip_updating_bottom_colour
    LDX start_screen_colour_one
    LDA #&1F                        \ TAB(&0c, start_screen_y)
    JSR OSWRCH                      \ OSWRCH
    LDA #&0C
    JSR OSWRCH                      \ OSWRCH
    LDA start_screen_y
    JSR OSWRCH                      \ OSWRCH
    LDA start_screen_colours_table,X
    ADC #&80                        \ TELETEXT_TEXT_COLOUR
    JSR OSWRCH                      \ OSWRCH
    INC start_screen_colour_one
    LDA start_screen_colour_one
    CMP #&0B
    BNE skip_wraparound_one
    LDA #&00
    STA start_screen_colour_one
.skip_wraparound_one
    INC start_screen_colour_two
    LDA start_screen_colour_two
    CMP #&0B
    BNE skip_wraparound_two
    LDA #&00
    STA start_screen_colour_two
    INC start_screen_y
    LDA start_screen_y
    CMP #&13
    BNE skip_wraparound_two
    LDA #&07
    STA start_screen_y
.skip_wraparound_two
    DEC scrolltext_cooldown
    BNE skip_updating_scrolltext
.update_scrolltext
    LDA #&07
    STA scrolltext_cooldown
    LDA #&1F                        \ TAB(&00, &16)
    JSR OSWRCH                      \ OSWRCH
    LDA #&00
    JSR OSWRCH                      \ OSWRCH
    LDA #&16
    JSR OSWRCH                      \ OSWRCH
    LDA #&86                        \ TELETEXT_CYAN
    JSR OSWRCH                      \ OSWRCH
    LDX #&00
.write_scrolltext_loop
    LDA scrolltext,X
    JSR OSWRCH                      \ OSWRCH    Write scrolltext
    INX
    CPX #&26
    BNE write_scrolltext_loop
.rotate_scrolltext
    LDA scrolltext
    STA first_character
    LDX #&00
.rotate_scrolltext_loop
    INX
    LDA scrolltext,X
    DEX
    STA scrolltext,X
    INX
    CPX #&56
    BNE rotate_scrolltext_loop
    LDA first_character
    STA scrolltext,X
.skip_updating_scrolltext
    LDA skill
    CMP #&06
    BCC start_game
    JMP start_screen_loop
.start_game
    LDX skill
    LDA starting_levels_table,X
    STA starting_level
    LDX #&00
    LDA #&30                        \ "0"
.initialise_wages_loop
    STA wages,X
    INX
    CPX #&06
    BNE initialise_wages_loop
    LDA #&01
    STA next_gold_position_offset
    LDA starting_level
    STA level
    LDA #&FF
    STA gold_state                  \ Set to &ff to indicate gold not falling
    LDA #&4C
    STA helicopter_x
    LDA #&CA
    STA helicopter_y
    LDA #&80
    STA spider_direction            \ Set to &80 to indicate spider moving down
    LDA #&01
    STA spider_y
    LDA #&01
    STA player_can_brake            \ Set to &01 to indicate player can brake
    JSR play_tune
    JSR play_game
    JMP start_screen
.unused_1121
    RTS

.update_gold
    LDA gold_state                  \ &ff if gold not falling
    CMP #&FF
    BEQ consider_dropping_gold_112c
    JMP update_falling_gold
.consider_dropping_gold_112c
    LDA helicopter_x
    LDX next_gold_position_offset
    CMP x_positions_table,X         \ Is the helicopter where the next gold is due?
    BEQ drop_gold
    RTS
.drop_gold
    LDA helicopter_y
    STA gold_y
    STA screen_y
    CLC
    LDA helicopter_x
    ADC #&04
    STA gold_x
    STA screen_x
    CLC
    LDA screen_y
    ADC #&20                        \ Consider surface of ground underneath helicopter
    STA screen_y
    CLC
    LDA screen_x
    ADC #&02
    STA screen_x
    JSR calculate_screen_address
    LDY row_in_group
    LDA (screen_address),Y
    CMP #&00                        \ Is there anything there?
    BNE is_hole                     \ If so, don't drop gold
    LDA helicopter_y
    CMP #&5F                        \ Is the helicopter on the second ground, where there
    BEQ is_hole                     \ is a horizontal enemy? If so, don't drop gold
    LDA helicopter_y
    STA gold_y
    STA screen_y
    CLC
    LDA helicopter_x
    ADC #&06
    STA screen_x
    CLC
    LDA helicopter_y
    ADC #&21                        \ Consider ground underneath helicopter
    STA screen_y
    JSR calculate_screen_address
    LDY row_in_group
highest_wages_1194 = * + 1
    LDA (screen_address),Y
    CMP #&00                        \ Is there a hole there?
    BEQ is_hole                     \ If so, don't drop gold
    JMP is_ground
.is_hole
start_screen_text_119d = * + 1
    LDA #&FF
    STA gold_state                  \ Set to &ff to indicate gold not falling
    RTS
.is_ground
    LDA helicopter_x
    CLC
    ADC #&04
    STA gold_x
    LDA helicopter_y
    STA gold_y
.update_falling_gold
    LDA gold_x
    STA screen_x
    LDA gold_y
    STA screen_y
    JSR calculate_screen_address
    LDA #LO(sprite_gold)
    STA sprite_address_low
    LDA #&17
    STA sprite_address_high
    JSR plot_sprite                 \ Plot gold
    INC gold_y
    INC gold_state
    LDA gold_state
    CMP #&11
    BNE not_on_ground
    LDA #&FF
    STA gold_state                  \ Set to &ff to indicate gold not falling
    INC next_gold_position_offset
    LDA next_gold_position_offset
    CMP #&28
    BNE skip_wraparound_11ec
    LDA #&01
    STA next_gold_position_offset
.skip_wraparound_11ec
.not_on_ground
    RTS

