.update_player
    JSR calculate_player_screen_address
    CLC
    LDA player_x_fraction           \ player_x += player_x_velocity * 3
    ADC player_x_velocity
    STA player_x_fraction
    LDA player_x
    ADC #&00
    STA player_x
    CLC
    LDA player_x_fraction
    ADC player_x_velocity
    STA player_x_fraction
    LDA player_x
    ADC #&00
    STA player_x
    CLC
    LDA player_x_fraction
    ADC player_x_velocity
    STA player_x_fraction
    LDA player_x
    ADC #&00
    STA player_x
    LDA #&11                        \ Play immediately on channel 1
    STA sound_block_0c30            \ (channel)
    LDA #&00
    STA sound_block_0c30 + 1        \ (channel high)
    LDA #&00
    STA sound_block_0c30 + 2        \ (volume)
    LDA #&00
    STA sound_block_0c30 + 3        \ (volume high)
    LDA player_x_velocity
    STA sound_block_0c30 + 4        \ (pitch)
    LSR sound_block_0c30 + 4        \ (pitch)
    LDA #&00
    STA sound_block_0c30 + 5        \ (pitch high)
    LDA #&01
    STA sound_block_0c30 + 6        \ (duration)
    LDA #&00
    STA sound_block_0c30 + 7        \ (duration high)
    LDX #LO(sound_block_0c30)
    LDY #&0C
    LDA #&07                        \ Generate a sound
    JSR OSWORD                      \ OSWORD    Play sound to set pitch for channel 0
    LDA #&03                        \ Unnecessary code
    STA sound_block_0c30 + 4        \ (pitch)
    LDA player_sprite_address_high
    CMP #&2B
    BEQ is_snow
.not_snow
    LDA #&10                        \ Play immediately on channel 0
    STA sound_block_0c30            \ (channel)
    LDA #&00
    STA sound_block_0c30 + 1        \ (channel high)
    LDA #&F1
    STA sound_block_0c30 + 2        \ (volume)
    LDA #&FF
    STA sound_block_0c30 + 3        \ (volume high)
    LDA #&03                        \ Periodic noise, pitch from channel 1
    STA sound_block_0c30 + 4        \ (pitch)
    LDA #&00
    STA sound_block_0c30 + 5        \ (pitch high)
    LDA #&02
    STA sound_block_0c30 + 6        \ (duration)
    LDA #&00
    STA sound_block_0c30 + 7        \ (duration high)
    LDX #LO(sound_block_0c30)
    LDY #&0C
    LDA #&07                        \ Generate a sound
    JSR OSWORD                      \ OSWORD    Play sound for player moving on land or sea
    JMP skip_snow_sound
.is_snow
    LDA player_jump_state
    CMP #&00
    BNE skip_snow_sound             \ If on snow, don't play sound if jumping
    LDA player_x_velocity
    CMP #&00
    BEQ skip_snow_sound             \ or stationary
    LDA #&10                        \ Play immediately on channel 0
    STA sound_block_0c30            \ (channel)
    LDA #&00
    STA sound_block_0c30 + 1        \ (channel high)
    LDA #&F9
    STA sound_block_0c30 + 2        \ (volume)
    LDA #&FF
    STA sound_block_0c30 + 3        \ (volume high)
    LDA #&04                        \ High frequency white noise
    STA sound_block_0c30 + 4        \ (pitch)
    LDA #&00
    STA sound_block_0c30 + 5        \ (pitch high)
    LDA #&02
    STA sound_block_0c30 + 6        \ (duration)
    LDA #&00
    STA sound_block_0c30 + 7        \ (duration high)
    LDX #LO(sound_block_0c30)
    LDY #&0C
    LDA #&07                        \ Generate a sound
    JSR OSWORD                      \ OSWORD    Play sound for player moving on snow
.skip_snow_sound
    LDX #&FF                        \ SHIFT
    LDY #&FF
    LDA #&81                        \ Scan for a particular key
    JSR OSBYTE                      \ OSBYTE
    CPX #&00
    BEQ shift_not_pressed
.shift_pressed    \ If SHIFT pressed,
    INC player_x_velocity           \ player_x_velocity += 3
    INC player_x_velocity
    INC player_x_velocity
    LDA player_x_velocity
    CMP #&FA                        \ 250
    BCC skip_ceiling_1cf3
    LDA #&FA                        \ 250
    STA player_x_velocity
.skip_ceiling_1cf3
.shift_not_pressed
    LDA player_x
    CMP #&4D
    BEQ is_end_of_ground
    LDA player_x
    CMP #&4C
    BEQ is_end_of_ground
    LDA player_x
    CMP #&4B
    BEQ is_end_of_ground
    JMP not_end_of_ground
.is_end_of_ground
    LDY level
.score_for_reaching_end_of_ground_loop
    JSR add_to_wages                \ Earn 10 * level for reaching end of ground
    DEY
    BNE score_for_reaching_end_of_ground_loop
    CLC
    LDA player_ground_y
    ADC #&38                        \ Move to next ground
    STA player_ground_y
    LDA #&00
    STA player_x
    LDA player_ground_y
    CMP #&18
    BNE not_end_of_level
    INC level
    LDA level
    CMP #&24                        \ 36    Level 36, set 12 snow
    BNE skip_wraparound_1d38
    LDA #&21                        \ 33    Level 33, set 11 snow
    STA level
.skip_wraparound_1d38
    JSR initialise_level
    JSR consider_plotting_holes
    JSR clear_paths_of_enemies
    LDA #&01
    STA player_can_brake            \ Set to non-zero to allow player to brake
.not_end_of_level
.not_end_of_ground
    LDX #&9D                        \ SPACE
    LDY #&FF
    LDA #&81                        \ Scan for a particular key
    JSR OSBYTE                      \ OSBYTE
    CPX #&00
    BEQ space_not_pressed
.space_pressed    \ If SPACE pressed,
    LDA player_jump_state
    CMP #&00
    BNE skip_starting_jump          \ and player not already jumping,
    LDA #&01
    STA player_jump_state           \ start jump
.skip_starting_jump
.space_not_pressed
    LDA player_jump_state
    CMP #&00
    BEQ not_jumping
.is_jumping_1d66
    INC player_jump_state
    LDA player_jump_state
    CMP #&1E                        \ 30
    BNE not_end_of_jump
    LDA #&00
    STA player_jump_state           \ Set to zero to indicate player isn't jumping
.not_end_of_jump
.not_jumping
    JSR replot_player
    LDA player_jump_state
    CMP #&00
    BNE not_falling                 \ If the player isn't jumping,
    LDA player_x
    STA screen_x
    LDA player_ground_y
    STA screen_y
    CLC
    LDA screen_y
    ADC #&10
    STA screen_y
    LDX player_jump_state
    LDA screen_y
    SEC
    SBC jump_offsets_table,X
    STA screen_y
    JSR calculate_screen_address
    LDY row_in_group
    LDA (screen_address),Y
    CMP #&00                        \ Is there a hole beneath the player?
    BNE not_falling
    JSR update_falling_player + 1   \ Bug: should be JSR &1e71 ; update_falling_player
    LDA #&00
    STA player_x_velocity           \ Player stops after fall
    LDA #&00
    STA player_jump_state           \ Set to zero to indicate player isn't jumping
.not_falling
    LDX #&B6                        \ RETURN
    LDY #&FF
    LDA #&81                        \ Scan for a particular key
    JSR OSBYTE                      \ OSBYTE
    CPX #&00
    BEQ return_not_pressed          \ If RETURN pressed,
.return_pressed
    LDA player_can_brake            \ &01 if player can brake, &00 if already braked
    CMP #&01
    BNE skip_braking                \ and player hasn't already braked,
    LDA #&00
    STA player_can_brake            \ Set to &00 to indicate player has already braked
    LDA #&00
    STA player_x_velocity           \ Stop player
.skip_braking
.return_not_pressed
    RTS

