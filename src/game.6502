.check_for_collision
    LDA #&00
    STA player_collided             \ Set to zero to indicate no collision (unused)
    LDA right_edge
    CMP #&00
    BEQ no_collision_on_right_edge
    LDA #&01                        \ Leave with non-zero to indicate collision
    STA player_collided             \ Unused variable
    RTS
.no_collision_on_right_edge
    LDA player_x                    \ Unnecessary code
    CLC
    ADC #&01
    CLC
    ADC #&01
    LDA player_ground_y
    STA screen_y
    LDX player_jump_state
    SEC
    LDA screen_y
    SBC jump_offsets_table,X
    STA screen_y
    DEC screen_y
    JSR calculate_screen_address    \ screen_x = player_x + 4 here (&1524)
    LDY row_in_group
    LDA (screen_address),Y          \ Check for collision at top right
    CMP #&00
    BEQ no_collision_top_right
    LDA #&01                        \ Leave with non-zero to indicate collision
    STA player_collided             \ Unused variable
    RTS
.no_collision_top_right
    LDA player_jump_state
    CMP #&00
    BNE is_jumping_1bad
    RTS
.is_jumping_1bad
    LDA player_x
    STA screen_x
    LDA player_ground_y
    STA screen_y
    LDX player_jump_state
    SEC
    LDA screen_y
    SBC jump_offsets_table,X
    STA screen_y
    CLC
    LDA screen_y
    ADC #&10
    STA screen_y
    JSR calculate_screen_address
    LDY row_in_group
    LDA (screen_address),Y          \ Check for collision below
    CMP #&00
    BEQ no_collision_below
    LDA #&01                        \ Leave with non-zero to indicate collision
    STA player_collided             \ Unused variable
    RTS
.no_collision_below
    RTS                             \ Leave with zero to indicate no collision

