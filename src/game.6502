    STA sprite_address_low
    LDA #&27
    STA sprite_address_high
    LDA player_x
    STA screen_x
    LDA player_ground_y
    STA screen_y
    SEC
    LDA screen_y
    SBC #&12
    STA screen_y
    LDA #&13                        \ Wait for vertical retrace
    JSR OSBYTE                      \ OSBYTE
    JSR calculate_screen_address
    JSR plot_sprite                 \ Unplot previous balloon
    LDA player_x
    STA screen_x
    LDA player_ground_y
    STA screen_y
    SEC
    LDA screen_y
    SBC #&12
    STA screen_y
