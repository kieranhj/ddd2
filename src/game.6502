    CMP #&4A
    BNE skip_ceiling_1ab8
    LDA #&49
    STA player_x
.skip_ceiling_1ab8
    INC player_jump_state
    LDA player_x
    STA screen_x
    LDA player_ground_y
    STA screen_y
    LDX player_jump_state
    LDA screen_y
    SBC jump_offsets_table,X
    STA screen_y
    LDA player_sprite_address_low
    STA sprite_address_low
    LDA player_sprite_address_high
    STA sprite_address_high
    JSR calculate_screen_address
    LDA #LO(sprite_dead_player_one)
    STA sprite_address_low
    LDA #&28
    STA sprite_address_high
    JSR plot_sprite                 \ Plot flying dead player
    LDA player_jump_state
    CMP #&20
    BEQ animate_dead_player
    JMP animate_flying_dead_player_loop
.animate_dead_player
    LDA #&07
    STA dead_player_count
.animate_dead_player_loop
    LDA #LO(sprite_dead_player_one)
    STA sprite_address_low
    LDA #&28
    STA sprite_address_high
    LDA player_x
    STA screen_x
    LDA player_ground_y
    STA screen_y
    JSR calculate_screen_address
    JSR plot_sprite                 \ Plot dead player frame one
    LDA #&0A                        \ 10
    STA death_delay
.death_delay_one_loop
    LDA #&13                        \ Wait for vertical retrace
    JSR OSBYTE                      \ OSBYTE
    DEC death_delay
    BNE death_delay_one_loop
    LDA #LO(sprite_dead_player_two)
    STA sprite_address_low
    LDA #&28
    STA sprite_address_high
    LDA player_x
    STA screen_x
    LDA player_ground_y
    STA screen_y
    JSR calculate_screen_address
    JSR plot_sprite                 \ Plot dead player frame two
    LDA #&0A
    STA death_delay
.death_delay_two_loop
    LDA #&13                        \ Wait for vertical retrace
    JSR OSBYTE                      \ OSBYTE
    DEC death_delay
    BNE death_delay_two_loop
    DEC dead_player_count
    BNE animate_dead_player_loop
    INC take
    RTS

