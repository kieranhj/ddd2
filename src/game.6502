.spider_direction
    EQUB &80

.spider_y
    EQUB &01

.update_spider
    LDA level
    CMP #&04
    BCC is_present_1679             \ Spider only on first set of levels
    RTS
.is_present_1679
    LDA spider_direction            \ &00 if moving up, &80 if moving down
    CMP #&80
    BNE is_moving_up
.is_moving_down
    INC spider_y                    \ Move spider down
    LDA spider_y
    CMP #&1A
    BNE replot_spider
    LDA #&00
    STA spider_direction            \ Set to &00 to indicate spider moving up
    JMP replot_spider
.is_moving_up
    DEC spider_y                    \ Move spider up
    LDA spider_y
    CMP #&01
    BNE replot_spider
    LDA #&80
    STA spider_direction            \ Set to &80 to indicate spider moving down
.replot_spider
    LDA #LO(sprite_spider)
    STA sprite_address_low
    LDA #&16
    STA sprite_address_high
    LDA #&28
    STA screen_x
    LDA #&BB                        \ Fourth ground
    STA screen_y
    CLC
    LDA screen_y
    ADC spider_y
    STA screen_y
    JSR calculate_screen_address
    JSR plot_sprite                 \ Plot spider
    RTS

