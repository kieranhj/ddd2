.you_are_fired_string
    EQUB &14    \ restore default logical colours
    EQUB &1F, &03, &11    \ TAB(&03, &11)
    EQUB &11, &08    \ COLOUR 8
    EQUB &59, &4F, &55, &20, &41, &52, &45, &20, &46, &49, &52, &45, &44    \ "YOU ARE FIRED"
    EQUB &0D

.play_game
    LDA #&01
    STA take
    LDA #&FF
    STA previous_level
    LDA #&CF
    STA helicopter_y
    LDA #&4C
    STA helicopter_x
    LDA #&01
    STA next_gold_position_offset
    LDA #&FF
    STA gold_state                  \ Set to &ff to indicate gold not falling
    LDA #&80
    STA spider_direction            \ Set to &80 to indicate spider moving down
    LDA #&01
    STA spider_y
    JSR clapperboard_screen
.new_take
    JSR initialise_level
    LDA #&08
    STA screen_x
    LDA #&38
    STA screen_y
    LDA #LO(sprite_blank)
    STA sprite_address_low
    LDA #&27
    STA sprite_address_high
    JSR calculate_screen_address
    JSR plot_sprite                 \ Clear any obstacle immediately in front of player
    JSR clear_paths_of_enemies
    JSR consider_plotting_holes
    JSR disable_cursor
.main_game_loop
    JSR update_rotating_colour_and_enemies
    JSR update_helicopter
    JSR update_spider
    JSR update_player
    LDA right_edge
    CMP #&1F                        \ YW
    BNE skip_collecting_gold        \ Is the player touching gold?
    JSR collect_gold
.skip_collecting_gold
    CLC
    LDA player_x
    ADC #&04
    STA screen_x
    SEC
    LDX player_jump_state
    LDA player_ground_y
    SBC jump_offsets_table,X
    STA screen_y
    CLC
    LDA screen_y
    ADC #&08
    STA screen_y
    JSR calculate_screen_address
    LDY row_in_group
    LDA (screen_address),Y          \ Check for collision at middle right
    CMP #&00
    BNE is_collision
    JSR check_for_collision         \ Returns non-zero if collision
    CMP #&00
    BEQ main_game_loop
.is_collision
    JSR kill_player
    LDA #&CF
    STA helicopter_y
    LDA #&4C
    STA helicopter_x
    LDA #&FF
    STA gold_state                  \ Set to &ff to indicate gold not falling
    LDA take
    CMP #&04
    BEQ game_over
    JSR clapperboard_screen
    LDA #&01
    STA player_can_brake            \ Set to &01 to indicate player can brake
    JMP new_take
.game_over
    LDX #&00
.write_you_are_fired_loop
    LDA you_are_fired_string,X
    JSR OSWRCH                      \ OSWRCH
    INX
    CPX #&13
    BNE write_you_are_fired_loop
    LDA #&00
    STA game_over_count
.game_over_loop
    JSR update_rotating_colour_and_enemies
    JSR update_spider
    INC game_over_count
    LDA game_over_count
    CMP #&3C
    BNE game_over_loop
    RTS

.consider_gaining_extra_take    \ Called with A = level ground colour
    STA level_ground_colour
    LDA #&80                        \ COLOUR 128 + 0
    JSR OSWRCH                      \ OSWRCH    First byte was written at &2427
    JSR disable_cursor
    LDA #&11                        \ COLOUR
    JSR OSWRCH                      \ OSWRCH    Second byte will be written at &2464
    LDA level
    CMP #&01
    BEQ skip_gaining_extra_take
    LDA level_type
    CMP #&01
    BNE skip_gaining_extra_take
    LDA previous_level
    CMP level
    BEQ skip_gaining_extra_take     \ Is this a new set of levels?
    LDA level
    STA previous_level
    LDA take
    CMP #&01
    BEQ skip_gaining_extra_take     \ If so, and not already on take one,
.gain_extra_take
    DEC take                        \ Gain extra take
    LDA #&12                        \ Play immediately on channel 2
    STA sound_block_0c30            \ (channel)    Bug: this overwrites level_ground_colour, but
    LDA #&00                        \ COLOUR &12 is green, which works for land level
    STA sound_block_0c30 + 1        \ (channel high)
    LDA #&03
    STA sound_block_0c30 + 2        \ (volume)
    LDA #&00
    STA sound_block_0c30 + 3        \ (volume high)
    LDA #&30
    STA sound_block_0c30 + 4        \ (pitch)
    LDA #&00
    STA sound_block_0c30 + 5        \ (pitch high)
    LDA #&01
    STA sound_block_0c30 + 6        \ (duration)
    LDA #&00
    STA sound_block_0c30 + 7        \ (duration high)
    LDX #LO(sound_block_0c30)
    LDY #&0C
    LDA #&07                        \ Generate a sound
    JSR OSWORD                      \ OSWORD    Play sound for gaining extra take
    LDA #&00
    STA count_0070
.gain_extra_take_delay_loop
    LDA #&13                        \ Wait for vertical retrace
    JSR OSBYTE                      \ OSBYTE
    INC count_0070
    LDA count_0070
    CMP #&2C                        \ 44
    BNE gain_extra_take_delay_loop
.skip_gaining_extra_take
    LDA #&01
    STA spider_y
    LDA #&80
    STA spider_direction            \ Set to &80 to indicate spider moving down
    LDA level_ground_colour
    RTS                             \ Leave with A = level ground colour

