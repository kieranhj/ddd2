\ ******************************************************************
\ *	sfx50.6502 - sound effects at 50 Hz, for a game that owns IRQ1V
\ ******************************************************************
\ *	beeb-port-kit, MIT, Kieran Connell 2026. Baron syntax, plain 6502.
\ *
\ *	WHAT IT IS. A small SN76489 driver for sound effects, run once a
\ *	field from the vsync interrupt. irq.6502 takes IRQ1V and passes
\ *	nothing to the MOS, so the MOS's 100 Hz tick, and its SOUND and
\ *	ENVELOPE driver with it, stop: THIS IS ITS REPLACEMENT for effects.
\ *	An effect is a list of RAMPS: over N fields the channel's period (or
\ *	noise control) and its amplitude each change by a fixed step a
\ *	field. The ramps are not written by hand: py/beeb_port_kit/sfx50.py
\ *	fits them to the MOS's own playing of the original SOUND/ENVELOPE
\ *	(captured by template/tools/sfxcapture.mjs) and writes the data file.
\ *
\ *	WHERE IT CAME FROM. Stryker's Run (Enhanced), its src/lib/sfx50.6502
\ *	(decision 25, docs/step2-layer3.md), 2026-10-16; into the kit
\ *	2026-10-25: the 65SC12 forms written as their NMOS ones (lib/
\ *	nmos.6502's STZ_LDA, BRA_xx: +2 cycles a chip write, +1 byte a JMP),
\ *	two unreached routines and a byte dropped, labels renamed.
\ *	Measured there (jsbeeb, Master 128):
\ *	  - Interrupts 10.9% of the CPU in play with the MOS's tick and
\ *	    sound, 2.2% with this (System VIA T1, the tick, off).
\ *	  - The game's 8 effects in 158 bytes of ramps and tables.
\ *	  - The fit: within a step or two of the MOS's period and amplitude
\ *	    field for field, sometimes half a field apart (the MOS ticks at
\ *	    100 Hz, this at 50, sampled every second tick).
\ *	  - No request on most fields: sfx_tick is 19 cycles then (+ the
\ *	    channels playing; JSR to RTS).
\ *	The MOS's driver is stateful (27 of 48 effect pairs end differently
\ *	over another effect than from silence, Stryker's Run's 8; its layer 3
\ *	said 38, from a capture that miscounted ticks, its BUGS #19); this
\ *	one is not: a request replaces what its channel was playing.
\ *	lib/test/sfx50_test.mjs (2026-10-25, jsbeeb 2.10.2) plays a fitted
\ *	effect through this code and checks the chip writes field by field
\ *	against the ramps it was given.
\ *
\ *	THE DATA (one file, generated by sfx50.py). 6 bytes a ramp:
\ *	  N (0: the end - the channel is silenced), period low, period high
\ *	  (noise: the noise control in the low byte), period step (signed, a
\ *	  field), amplitude * 16 + 8, amplitude step (signed, sixteenths)
\ *	and two tables, sfx_effect_lo / sfx_effect_hi, of the effects'
\ *	addresses. EVERY EFFECT MUST LIE AT &1000 OR ABOVE: a request puts
\ *	the effect's page into sfx_written as "nothing sent yet", and a
\ *	page below &10 could match an amplitude (0-15) or noise control
\ *	(0-7) and so suppress the first write.
\ *
\ *	TO START effect E (0-based) on chip channel C (0-2 tone, 3 noise),
\ *	from anywhere: store E + 1 into sfx_request + C. The driver takes it
\ *	at its next tick, replacing what the channel was playing (a request
\ *	posted between the driver's read and its clear is lost: the next
\ *	replaces it). The chip's channel is the effect's: SOUND's channel 0
\ *	(noise) is chip channel 3, SOUND's 1-3 are tones 2-0 (sfx50.py and
\ *	sfxcapture.mjs follow the same rule).
\ *
\ *	sfx_silence stops all four channels and forgets them and their
\ *	requests: call it when the game takes the machine from the MOS (the
\ *	MOS's notes stop where they are; irq.6502's install_irq silences
\ *	the chip too) and before giving it back.
\ *
\ *	THE CHIP is written as MOS 3.20 writes it (&F5E6): System VIA port
\ *	A all outputs, the byte, then the addressable latch's line 0 (the
\ *	chip's write enable) low and high again. The next byte is worked out
\ *	while the write enable is low (the MOS's delay there). The MOS's
\ *	wait after the write enable goes high (LDY #4 loop, 21 cycles) is
\ *	not here: the next write enable falls at least 20 cycles later, and
\ *	the chip needs 32 of its 4 MHz clocks, 16 cycles. The noise control
\ *	is written only when it changes (writing it restarts the noise), a
\ *	tone's amplitude likewise. Port A's DDRA is left &FF: keydown.6502
\ *	sets its own every call.
\ *
\ *	INTERRUPTS OFF in sfx_tick (it runs in the interrupt) and in
\ *	sfx_silence (which disables them itself). Nothing here touches a
\ *	sideways bank: if the effects live in one, the vsync hook pages it
\ *	(irq.6502's header: save ROMSHAD, not ROMSEL). The interrupt must
\ *	see sfx_request and the effects whatever the game has paged.
\ *
\ *	THE INCLUDER DEFINES: sfx_request (4 bytes, zero at start, where
\ *	the interrupt always sees them), sfx_effect_lo / sfx_effect_hi
\ *	(sfx50.py's file), and beeb.h.6502's SYS_VIA_ORB, SYS_VIA_DDRA,
\ *	SYS_VIA_ORA_NH. The driver's own 36 bytes of state are at its end
\ *	(SKIP, in this section). Uses A, X, Y. Self-modifying (the ramp
\ *	reads), so it runs from RAM.
\ ******************************************************************

\ Once a field, interrupts off.
.sfx_tick
{
    lda sfx_request                 ; any request this tick? (most have none: 19 cycles, not 28)
    ora sfx_request + 1
    ora sfx_request + 2
    ora sfx_request + 3
    beq req_none
    ldx #3                          ; the requests first, all four channels (no effect's first
.req_each                           ; ramp is empty, so this writes nothing to the chip)
    lda sfx_request,X
    beq req_next
    tay                             ; E + 1: the tables are read one byte early
    lda #0
    sta sfx_request,X
    lda sfx_effect_lo - 1,Y
    sta sfx_ptr_lo,X
    lda sfx_effect_hi - 1,Y
    sta sfx_ptr_hi,X
    sta sfx_written,X               ; nothing sent yet: a page, never 0-15 (the header's &1000 rule)
    jsr sfx_next_ramp
.req_next
    dex
    bpl req_each
.req_none
    ldx #3                          ; then each channel's step
.channel
    lda sfx_n,X
    beq next
    jsr sfx_output
    clc                             ; both paths add with C = 0 (LDA and BPL keep C)
    lda sfx_dp,X                    ; the period steps (16 bits, the step sign-extended)
    bpl up
    adc sfx_p_lo,X                  ; the step negative (its high byte &FF): a carry leaves the high byte
    sta sfx_p_lo,X
    bcs pa_clc
    dec sfx_p_hi,X                  ; no carry: the high byte less 1
    bcc pa_c0                       ; always (C = 0)
.up
    adc sfx_p_lo,X
    sta sfx_p_lo,X
    bcc pa_c0                       ; C = 0
    inc sfx_p_hi,X
.pa_clc
    clc
.pa_c0
    lda sfx_dv,X                    ; the amplitude steps, kept between 0 and 15
    bpl v_nonneg
    adc sfx_v,X                     ; a negative step (C = 0 on every path here)
    bcc v_clamp0
.v_known
    sta sfx_v,X
.v_same
    dec sfx_n,X
    bne next
    jsr sfx_next_ramp
.next
    dex
    bpl channel
    rts
.v_nonneg
    beq v_same                      ; no step: sfx_v stays
    adc sfx_v,X
    bcc v_known
    lda #&F8                        ; past 15: 15
    bne v_known                     ; always
.v_clamp0
    lda #0
    beq v_known                     ; always
}

\ X = channel: its next ramp, from sfx_ptr; at the end, the channel is silenced.
\ Each byte's load is self-modified to the ramp's page, Y its low byte (a page
\ is crossed exactly where an LDA (ptr),Y would cross one).
.sfx_next_ramp
{
    lda sfx_ptr_hi,X
    sta b0 + 2
    ldy sfx_ptr_lo,X
.b0
    lda &FF00,Y                     ; self-modified: the ramp's page
    beq ended
    sta sfx_n,X
    lda sfx_ptr_hi,X
    sta b1 + 2
    sta b2 + 2
    sta b3 + 2
    sta b4 + 2
    sta b5 + 2
.b1
    lda &FF01,Y                     ; self-modified, as b0
    sta sfx_p_lo,X
.b2
    lda &FF02,Y
    sta sfx_p_hi,X
.b3
    lda &FF03,Y
    sta sfx_dp,X
.b4
    lda &FF04,Y
    sta sfx_v,X
.b5
    lda &FF05,Y
    sta sfx_dv,X
    tya                             ; the next ramp, 6 bytes on (Y = sfx_ptr_lo)
    clc
    adc #6
    sta sfx_ptr_lo,X
    bcc same_page
    inc sfx_ptr_hi,X
.same_page
    rts
.ended                              ; X = channel: off and forgotten (sfx_silence's entry)
    lda #0
    sta sfx_n,X
    lda sfx_channel_bits,X
    ora #&9F                        ; attenuation 15: off
    bne sfx_write                   ; always
}

\ X = channel: its period (or noise control) and amplitude to the chip.
.sfx_output
{
    cpx #3
    beq sfx_write.noise
    lda sfx_p_lo,X                  ; tone: the latch byte with the period's low 4 bits...
    and #&0F
    ora sfx_channel_bits,X
    jsr sfx_write                   ; ...after which A = the period's high 6 bits
    jsr sfx_write.again             ; written; after which A = the amplitude, v >> 4
    cmp sfx_written,X               ; what the chip has: unchanged, nothing to send
    beq sfx_write.done
    sta sfx_written,X
    eor att_bits,X                  ; an amplitude latch byte: (n EOR &1F) OR the channel's bits
    jmp sfx_write.again
.att_bits
    EQUB &9F, &BF, &DF, &FF         ; channel bits OR &1F
.amplitude                          ; the noise channel's amplitude: every field
    lda sfx_v,X
    lsr A
    lsr A
    lsr A
    lsr A
    eor att_bits,X
}
    \ falls through
\ A to the chip. Keeps X. While the write enable is low, the byte for the next
\ write is worked out: after sfx_write, A = a tone's high byte (from the period
\ just stepped); after sfx_write.again, A = the amplitude v >> 4. Callers other
\ than sfx_output's tone ignore A.
.sfx_write
{
    ldy #&FF
    sty SYS_VIA_DDRA
    sta SYS_VIA_ORA_NH
    lda #0
    sta SYS_VIA_ORB                 ; latch line 0 low: write enable
    lda sfx_p_hi,X                  ; a tone's high byte, the period >> 4: C = bit 0 of the high byte,
    lsr A                           ; A = its bit 1 in bit 0 with the low byte's bits 7-4 above (the
    eor sfx_p_lo,X                  ; rest of the low nibble is dropped below)
    and #&01
    eor sfx_p_lo,X
    ror A                           ; the two bits of the high byte enter at the top and the low
    ror A                           ; byte's high nibble comes down beside them: 0 0 h1 h0 l7-l4
    lsr A
    lsr A
    bpl wen_high                    ; always
.again                              ; DDRA already &FF (sfx_output's tone)
    sta SYS_VIA_ORA_NH
    lda #0
    sta SYS_VIA_ORB                 ; latch line 0 low: write enable
    lda sfx_v,X                     ; the amplitude, n = v >> 4
    lsr A
    lsr A
    lsr A
    lsr A
.wen_high
    ldy #&08
    sty SYS_VIA_ORB                 ; and high again
.done
    rts
.noise                              ; sfx_output's noise channel
    lda sfx_p_lo,X                  ; the noise control, only when it changes (writing it restarts the noise)
    and #&07
    cmp sfx_written,X
    beq sfx_output.amplitude
    sta sfx_written,X
    ora #&E0
    jsr sfx_write
    bne sfx_output.amplitude        ; always: sfx_write's LDY #&08 left Z = 0
}

\ All four channels off, and forgotten (requests too).
.sfx_silence
{
    php
    sei
    ldx #3
.each
    lda #0
    sta sfx_request,X
    jsr sfx_next_ramp.ended
    dex
    bpl each
    plp
    rts
}

.sfx_channel_bits                   ; the chip's channel in a latch byte: tone 0-2, noise
    EQUB &80, &A0, &C0, &E0
.sfx_ptr_lo     SKIP 4
.sfx_ptr_hi     SKIP 4
.sfx_n          EQUB 0, 0, 0, 0     ; fields left in the ramp: 0, the channel is idle
.sfx_p_lo       SKIP 4
.sfx_p_hi       SKIP 4
.sfx_dp         SKIP 4
.sfx_v          SKIP 4
.sfx_dv         SKIP 4
.sfx_written    SKIP 4              ; the noise control (channel 3) or amplitude (0-2) last sent
